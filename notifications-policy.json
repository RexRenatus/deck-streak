{
  "schema": "phx.notifications.policy.v1",
  "surfaces": [
    "bot",
    "mini-app"
  ],
  "router": {
    "module": "crates/notifications/src/router.rs",
    "symbol": "route",
    "transport": {
      "bot": [
        "push_message",
        "push_reveal",
        "push_dice",
        "push_reaction",
        "push_pin",
        "push_photo",
        "prepare_share"
      ],
      "mini-app": [
        "push_in_app"
      ]
    }
  },
  "kinds": {
    "celebration": {
      "class": "celebration",
      "tiers": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "budget": "celebration",
      "dedupe": "once-ever",
      "setting": "celebrations_enabled"
    },
    "digest": {
      "class": "digest",
      "tiers": [
        "T2"
      ],
      "budget": null,
      "dedupe": "per-study-day",
      "setting": "digest_enabled"
    },
    "morning": {
      "class": "nudge",
      "tiers": [
        "T2"
      ],
      "budget": null,
      "dedupe": "per-study-day",
      "setting": "morning_enabled"
    },
    "streak_risk": {
      "class": "nudge",
      "tiers": [
        "T2"
      ],
      "budget": "evening",
      "dedupe": "per-study-day",
      "setting": "evening_enabled"
    },
    "last_chance": {
      "class": "nudge",
      "tiers": [
        "T2"
      ],
      "budget": "evening",
      "dedupe": "per-study-day",
      "setting": "last_chance_enabled"
    },
    "habit": {
      "class": "nudge",
      "tiers": [
        "T2"
      ],
      "budget": null,
      "dedupe": "per-study-day",
      "setting": "habit_enabled"
    },
    "comeback": {
      "class": "nudge",
      "tiers": [
        "T2"
      ],
      "budget": "comeback",
      "dedupe": "per-episode-day",
      "setting": "comeback_enabled"
    },
    "reading_ready": {
      "class": "nudge",
      "tiers": [
        "T2"
      ],
      "budget": null,
      "dedupe": "per-study-day",
      "setting": "reading_ready_enabled"
    },
    "alert": {
      "class": "alert",
      "tiers": [
        "T2"
      ],
      "budget": null,
      "dedupe": "per-incident",
      "setting": null
    }
  },
  "ladder": {
    "tiers": {
      "T0": "silent",
      "T1": "reaction",
      "T2": "line",
      "T3": "reveal",
      "T4": "dice",
      "T5": "dice-pin"
    },
    "rarity": {
      "common": "T2",
      "rare": "T3",
      "epic": "T4",
      "legendary": "T5"
    },
    "rarity_floor": {
      "epic": "T2",
      "legendary": "T2"
    },
    "events": {
      "badge": "T2",
      "level_up": "T2",
      "quest": "T2",
      "quest_all": "T3",
      "record": "T3",
      "season_node": "T2",
      "season_node_final": "T3",
      "queue_zero": "T4",
      "ghost_win": "T4",
      "band_up": "T5",
      "ceremony": "T5",
      "share_card": "T5",
      "landmark_anniversary": "T2",
      "landmark_study_day": "T2"
    },
    "unknown_event": "T2",
    "reaction_max_age_hours": 24,
    "dedupe": "once-ever"
  },
  "celebration_budgets": {
    "window": "week",
    "intensities": {
      "quiet": {
        "T4": 1,
        "T5": 0
      },
      "standard": {
        "T4": 2,
        "T5": 1
      },
      "loud": {
        "T4": 3,
        "T5": 2
      }
    },
    "default_intensity": "standard",
    "downgrade": {
      "T5": "T4",
      "T4": "T3"
    },
    "exempt_events": [
      "band_up"
    ]
  },
  "streak_break": {
    "cap": "T1",
    "defer_fanfare": true
  },
  "near_miss": {
    "max_units": 5,
    "max_fraction": 0.1
  },
  "quiet_hours": {
    "start": "23:00",
    "end": "07:30",
    "celebrations": "defer",
    "nudges": "suppress",
    "exempt_classes": [
      "alert"
    ]
  },
  "digest": {
    "at": "09:05",
    "rollover": "04:00"
  },
  "deferral": {
    "max_age_minutes": 720,
    "flush_max": 2,
    "queue_max": 20,
    "overflow": "rollup",
    "recap_at_flush": true,
    "named_drops": true
  },
  "send_failure": {
    "hold": true,
    "retry_max": 2,
    "outage_cooldown_ms": 60000,
    "keep_first_deferred_at": true
  },
  "nudge_budgets": {
    "evening": {
      "per_day": 2,
      "exempt": [
        "user_requested"
      ],
      "exempt_checked_first": true
    }
  },
  "lapse": {
    "after_zero_days": 3,
    "suppress_classes": [
      "nudge"
    ],
    "escalation": "none",
    "habit_backoff": {
      "after_days": 5,
      "interval_days": 3
    }
  },
  "comeback": {
    "max_per_episode": 3,
    "min_gap_days": 3,
    "episode_key": "lapse_id",
    "after_cap": "silence",
    "landmarks": {
      "monday_window_days": 3,
      "month_start_window_days": 7
    },
    "disable_value": "0"
  },
  "holdout": {
    "pct": 10,
    "max_pct": 50,
    "draw": "hash",
    "seed": "persisted",
    "kinds": [
      "morning",
      "streak_risk",
      "last_chance"
    ],
    "record_held": true,
    "held_consumes_budget": false,
    "readout_min_n": 10
  },
  "withhold": {
    "record": true,
    "kind_suffix": ":withheld",
    "reasons": [
      "lapse",
      "skip_day",
      "quiet_hours",
      "budget_spent",
      "below_streak_min",
      "already_studied",
      "ablation_hold",
      "no_notifier",
      "photo_unsupported",
      "nudges_disabled",
      "no_payload",
      "already_recorded"
    ]
  },
  "deviations": [
    {
      "key": "kinds.reading_ready",
      "adr": "docs/decisions/ADR-041-notification-router-core.md"
    },
    {
      "key": "withhold.reasons",
      "adr": "docs/decisions/ADR-135-images-are-drawn-through-a-port-with-no-provider-wired-by-a-sending-job-capped-cached-and-gated.md"
    }
  ]
}
