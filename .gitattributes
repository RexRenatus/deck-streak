# Normalise line endings in the repository to LF, whatever each contributor's platform checks out.
* text=auto eol=lf

# Binary files: no line-ending conversion and no textual diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated lockfiles: collapsed in GitHub's diff view.
Cargo.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
