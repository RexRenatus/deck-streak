name: planted
on:
  push:
jobs:
  cargo:
    runs-on: planted
    steps:
      - run: cargo build -p planted
      - run: cargo build --locked -p planted
      - run: cargo test --frozen -p planted
      - run: |
          cargo test -p planted \
            --locked
      - run: cargo test -p planted -- --locked
      - run: cargo fmt --check
      - run: cargo metadata --format-version 1
      - run: timeout --kill-after=60 "$budget" cargo nextest run -p planted
      - run: cargo install cargo-planted
      - run: cargo install --locked cargo-planted
      - run: cargo mutants --list
      - run: cargo mutants --cargo-arg=--locked --list
      - run: need cargo "a message, then more words"
      # - run: cargo build -p commented
  node:
    runs-on: planted
    steps:
      - uses: pnpm/action-setup@planted
        with:
          run_install: true
      - run: pnpm install
      - run: pnpm install --frozen-lockfile
      - run: pnpm --dir web/app install --no-frozen-lockfile
      - run: pnpm --dir web/app exec playwright test
      - run: npm ci
      - run: npm install
  apple:
    runs-on: planted
    steps:
      - run: swift test --package-path planted
      - run: swift build --package-path planted --only-use-versions-from-resolved-file
      - run: xcodebuild build -project planted.xcodeproj -scheme Planted
      - run: xcodebuild build -workspace planted.xcworkspace -scheme Planted
      - run: xcodebuild -create-xcframework -library planted.a -output planted.xcframework
      - run: python -m pip install --require-hashes -r planted.txt
      - run: python -m pip install planted
      - run: |
          python3 - <<'PY'
          cargo = "build"
          PY
          cat <<'SH' > "$RUNNER_TEMP/planted.sh"
          cargo build -p planted
          SH
      - run: cargo test ${{ matrix.flags }}
      - run: scripts/planted.sh --planted
