# Planted for test_lock_duplicates.py, read as text and never run: a bare dependency string names
# alpha, which the lock holds at two versions, so it names no one entry and is undecided.
version = 4

[[package]]
name = "alpha"
version = "1.0.0"
source = "registry+https://github.com/rust-lang/crates.io-index"

[[package]]
name = "alpha"
version = "2.0.0"
source = "registry+https://github.com/rust-lang/crates.io-index"

[[package]]
name = "planted-root"
version = "0.1.0"
dependencies = [
 "alpha",
]
