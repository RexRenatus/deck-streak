<!-- Planted for the redundant-guard census (SPEC-665 R5 to R10); read as text, never compiled. -->
<script lang="ts">
  let { ready, count, counts, value }: { ready: boolean; count: number; counts: number[]; value?: string } = $props();

  function closure(flag: boolean): () => number {
    if (flag) {
      return () => {
        if (flag) { // accepted: closure
          return 1;
        }
        return 0;
      };
    }
    return () => 0;
  }

  function reassigned(start: number): number {
    let current = start;
    if (current > 3) {
      current = 0;
      if (current > 3) { // accepted: reassigned
        return 1;
      }
    }
    return current;
  }

  function called(items: number[]): boolean {
    if (items.includes(3)) {
      if (items.includes(3)) { // accepted: call
        return true;
      }
    }
    return false;
  }
</script>

{#if ready}
  {#if ready}<!-- planted: same-expression -->
    <p>ready</p>
  {/if}
{/if}
{#if count > 10}
  {#if count > 5}<!-- planted: range -->
    <p>many</p>
  {/if}
{/if}
{#if value !== undefined}
  {#if value === undefined}<!-- planted: presence -->
    <p>none</p>
  {/if}
{/if}

{#if count > 3}
  {#each counts as count}
    {#if count > 3}<!-- accepted: loop -->
      <p>{count}</p>
    {/if}
  {/each}
{/if}

<script module lang="ts">
  export function looped(start: number): number {
    let current = start;
    let kept = 0;
    if (current > 3) {
      while (current > 0) { // accepted: loop
        if (current > 3) { // accepted: loop
          kept += 1;
        }
        current -= 1;
      }
    }
    return kept;
  }
</script>
