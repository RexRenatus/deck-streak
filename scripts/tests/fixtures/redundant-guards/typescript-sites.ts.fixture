}

export function reassigned(count: number): number {
  let current = count;
  if (current > 3) {
    current = 0;
    if (current > 3) { // accepted: reassigned
      return 1;
    }
  }
  return current;
}

export function called(items: number[]): boolean {
  if (items.includes(3)) {
    if (items.includes(3)) { // accepted: call
      return true;
    }
  }
  return false;
}

export function looped(start: number): number {
  let current = start;
  let kept = 0;
  if (current > 3) {
    do {
      if (current > 3) { // accepted: loop
        kept += 1;
      }
      current -= 1;
    } while (current > 0);
  }
