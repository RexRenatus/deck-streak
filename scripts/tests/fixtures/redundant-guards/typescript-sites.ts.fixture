export function sameExpression(ready: boolean, count: number): number {
  if (ready && count > 0) {
    if (ready) { // planted: same-expression
      return 1;
    }
  }
  return 0;
}

export function rangeCheck(count: number): number {
  if (count === 10) {
    if (count !== 10) { // planted: range
      return 2;
    }
  }
  return 0;
}

export function presence(value: string | undefined): number {
  if (value !== undefined) {
    if (value === undefined) { // planted: presence
