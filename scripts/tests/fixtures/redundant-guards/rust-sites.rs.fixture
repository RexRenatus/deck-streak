fn looped(mut count: i64, rounds: &[i64]) -> i64 {
    let mut kept = 0;
    if count > 3 {
        for round in rounds {
            if count > 3 { // accepted: loop
                kept += 1;
            }
            count -= 1;
        }
    }
    kept
}

fn spun(mut count: i64) -> i64 {
    let mut kept = 0;
    if count > 3 {
        loop {
            if count > 3 { // accepted: loop
                kept += 1;
            }
            count -= 1;
            if count < 0 {
                break;
            }
        }
    }
    kept
}
