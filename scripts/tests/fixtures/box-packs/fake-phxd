#!/usr/bin/env python3
"""A fake phxd for scripts/tests/test_box_packs.py (SPEC-030 A9 to A13).

It answers the verbs scripts/box-packs.sh calls the way phxd does, from the fake phoenix checkout
beside it and the planted cards below, so the tests need neither phxd nor phoenix-v2:

* `pack list --skills-root DIR` lists the packs DIR/catalog.json names, each with its schemas;
* `pack probe --pack P --root R --skills-root DIR` prints P's planted probe card, or refuses
  `wrong_verb` (exit 4, no card) when P's catalog row declares another schema;
* `--ledger L init` creates L, and `--ledger L project register --slug S --name N --repo R` records
  project 1 in L and prints `registered project#1 as ...`;
* `--ledger L pack run --pack P --project ID --skills-root DIR` prints P's planted run card, and
  refuses as phxd does without that ledger, that project or that verb;
* `verify seo-pipeline --subject DIR` prints a planted seo-pipeline card.

A planted row is red when FAKE_PHXD_RED (comma-separated row ids) names it. Every call appends one
JSON line to FAKE_PHXD_LOG: its argv, its working directory, and, for a verb given a tree (`--root`,
`--repo` or `--subject`), the census of that tree as {path: sha256 of the contents}, so a test can
read what was judged after the runner has removed it.
"""

import hashlib
import json
import os
import sys
from pathlib import Path

# The planted cards: each pack's rows as (id, severity), in the severities each verb's card uses.
PLANTED = {
    "alpha": (
        ("alpha.first", "block"),
        ("alpha.second", "block"),
        ("alpha.heuristic", "advisory"),
    ),
    "beta": (
        ("beta.first", "blocking"),
        ("beta.second", "blocking"),
        ("beta.heuristic", "advisory"),
        ("beta.vocabulary", "catalog"),
    ),
}
SEO_STAGES = ("technical", "on-page", "social")
SCHEMAS = {
    "probe": "phxd.pack.probe.v1",
    "run": "phxd.pack.run.v1",
    "verify": "phxd.seo-pipeline.v1",
}


def main(argv):
    log = os.environ.get("FAKE_PHXD_LOG")
    if not log:
        print("fake phxd: FAKE_PHXD_LOG is not set", file=sys.stderr)
        return 2
    red = {row for row in os.environ.get("FAKE_PHXD_RED", "").split(",") if row}
    ledger = None
    if argv[:1] == ["--ledger"]:
        ledger, argv = Path(argv[1]), argv[2:]
    words, options = parse(argv)
    record = {"argv": sys.argv[1:], "cwd": os.getcwd()}
    tree = options.get("--root") or options.get("--repo") or options.get("--subject")
    if tree:
        record["census"] = census(Path(tree))
    with open(log, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(record) + "\n")
    if words == ["init"]:
        return init(ledger)
    if words == ["project", "register"]:
        return register(ledger, options)
    if words == ["pack", "list"]:
        return pack_list(options)
    if words == ["pack", "probe"]:
        return pack_card("probe", options, red)
    if words == ["pack", "run"]:
        return pack_run(ledger, options, red)
    if words == ["verify", "seo-pipeline"]:
        return seo_card(options, red)
    print(f"fake phxd: no verb {' '.join(words)}", file=sys.stderr)
    return 2


def parse(argv):
    words, options, index = [], {}, 0
    while index < len(argv):
        word = argv[index]
        if word.startswith("--") and index + 1 < len(argv):
            options[word] = argv[index + 1]
            index += 2
        else:
            words.append(word)
            index += 1
    return words, options


def census(tree):
    files = sorted(path for path in tree.rglob("*") if path.is_file())
    return {
        path.relative_to(tree).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
        for path in files
        if ".git" not in path.relative_to(tree).parts
    }


def init(ledger):
    if ledger is None:
        print("phxd: init needs a ledger", file=sys.stderr)
        return 2
    ledger.write_text("", encoding="utf-8")
    print(f"ledger ready at {ledger}")
    return 0


def register(ledger, options):
    if ledger is None or not ledger.is_file():
        print("phxd: no ledger; run init first", file=sys.stderr)
        return 1
    row = {"project": 1, "slug": options["--slug"], "repo": options["--repo"]}
    with open(ledger, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(row) + "\n")
    print(f"registered project#1 as `{options['--slug']}`")
    return 0


def catalog(options):
    """The catalog's rows, or None when no --skills-root names one (phxd then walks its cwd)."""
    root = options.get("--skills-root")
    path = Path(root) / "catalog.json" if root else None
    if path is None or not path.is_file():
        print("phxd: skills/catalog.json not found", file=sys.stderr)
        return None
    return json.loads(path.read_text(encoding="utf-8"))["skills"]


def pack_list(options):
    skills = catalog(options)
    if skills is None:
        return 4
    packs = [
        {
            "id": skill["id"],
            "gate": skill["gate"],
            "requires_phxd_schema": skill["requires_phxd_schema"],
        }
        for skill in skills
        if skill["kind"] == "pack"
    ]
    print(json.dumps({"examined": len(packs), "packs": packs}))
    return 0


def admits(verb, options):
    """phxd's admission rule: a verb runs a pack iff its catalog row declares that verb's card."""
    pack = options.get("--pack", "seo-pipeline")
    skills = catalog(options)
    if skills is None:
        return False
    rows = [skill for skill in skills if skill["id"] == f"packs/{pack}"]
    if not rows:
        print(f"phxd: unknown_pack catalog row: {pack}", file=sys.stderr)
        return False
    declared = rows[0]["requires_phxd_schema"]
    if SCHEMAS[verb] not in declared:
        print(
            f"phxd: wrong_verb: packs/{pack} declares {declared[0]}; "
            f"this verb admits rows declaring {SCHEMAS[verb]}",
            file=sys.stderr,
        )
        return False
    return True


def pack_card(verb, options, red):
    if not admits(verb, options):
        return 4
    pack = options["--pack"]
    rows = []
    failed = False
    for ident, severity in PLANTED[pack]:
        advisory = severity == "advisory"
        planted = ident in red
        failed = failed or (planted and not advisory)
        color = ("advisory" if advisory else "red") if planted else "green"
        row = {"id": ident, "ran": True, "exit": 1 if planted else 0, "color": color}
        if advisory:
            row["severity"] = "advisory"
        rows.append(row)
    card = {
        "schema": SCHEMAS["probe"],
        "pack": pack,
        "examined": len(rows),
        "color": "red" if failed else "green",
        "checks": rows,
    }
    print(json.dumps(card))
    return 4 if failed else 0


def pack_run(ledger, options, red):
    if ledger is None or not ledger.is_file():
        print("phxd: pack run: no ledger", file=sys.stderr)
        return 1
    projects = [json.loads(line) for line in ledger.read_text(encoding="utf-8").splitlines()]
    if str(options.get("--project")) not in {str(row["project"]) for row in projects}:
        print(f"phxd: pack run: unknown project {options.get('--project')}", file=sys.stderr)
        return 1
    if not admits("run", options):
        return 4
    pack = options["--pack"]
    rows = []
    failed = False
    examined = 0
    for ident, severity in PLANTED[pack]:
        if severity == "catalog":
            rows.append({"id": ident, "severity": severity, "verdict": "catalog"})
            continue
        examined += 1
        planted = ident in red
        verdict = "ok"
        if planted:
            verdict = "advisory" if severity == "advisory" else "red"
        failed = failed or verdict == "red"
        rows.append({"id": ident, "severity": severity, "verdict": verdict})
    card = {
        "schema": SCHEMAS["run"],
        "pack": pack,
        "project_id": int(options["--project"]),
        "verdict": "red" if failed else "ok",
        "examined": examined,
        "checks": rows,
    }
    print(json.dumps(card))
    return 4 if failed else 0


def seo_card(options, red):
    subject = Path(options["--subject"])
    if not subject.is_dir():
        print(f"phxd: verify seo-pipeline: subject is not a directory: {subject}", file=sys.stderr)
        return 4
    stages = [
        {"id": stage, "verdict": "red" if stage in red else "green"} for stage in SEO_STAGES
    ]
    failed = any(stage["verdict"] == "red" for stage in stages)
    card = {
        "schema": SCHEMAS["verify"],
        "pack": "packs/seo-pipeline",
        "verdict": "refuse" if failed else "pass",
        "stages": stages,
        "examined": {"pages": len(list(subject.rglob("*.html")))},
    }
    print(json.dumps(card))
    return 4 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
