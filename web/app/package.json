{
  "name": "@deck-streak/app",
  "private": true,
  "version": "0.3.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:card": "playwright test --config playwright.card.config.ts",
    "test:engine": "playwright test --config playwright.engine.config.ts",
    "test:study": "playwright test --config playwright.study.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/paraglide-js": "^2.29.2",
    "@inlang/plugin-message-format": "^4.5.5",
    "@lucide/svelte": "^1.62.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/commonmark": "0.27.10",
    "@types/node": "^24.19.2",
    "cn": "^0.5.0",
    "commonmark": "0.31.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^30.1.3",
    "mermaid": "12.2.0",
    "shadcn-svelte": "^1.7.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "catalog:"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
