# DeckStreak's settings, by name (SPEC-020 R22, SPEC-025 R10, SPEC-024 R2). Copy this file to .env for a local run; .env is
# never committed. A setting left unset takes the default its comment names. A secret is never a
# variable here: it reaches a process as a systemd credential (ADR-010).

# The hour the study day turns over, 0 to 23. Default 4.
DECKSTREAK_ROLLOVER_HOUR=4

# The fixed offset from UTC the rollover hour is local to, in whole minutes, -720 to 840. Default 0;
# a deployment's own offset is private configuration.
DECKSTREAK_UTC_OFFSET_MINUTES=0

# The hour the daily digest goes out, 0 to 23, never before the rollover hour. Unset, it is the
# larger of 9 and the rollover hour.
DECKSTREAK_DIGEST_HOUR=

# How many blocking operations run at once, 1 to 512. Default 1.
DECKSTREAK_OFFLOAD_WORKERS=1

# The log level, in tracing's filter directives. Default info.
RUST_LOG=info

# The directory systemd passes a unit's credentials in (LoadCredential=). systemd sets it; set it
# by hand only to point a local run at a directory of synthetic credentials. The `api` and `bot`
# roles read two credentials from it, and refuse start by the id of one that is missing:
# owner-user-id (the owner's Telegram user id) and telegram-bot-token (ADR-038).
CREDENTIALS_DIRECTORY=

# The Anki sync server's URL, http: or https:, required (SPEC-022). A deployment's own URL is
# private configuration; a plain http: URL sends the sync credentials in the clear. The account's
# username and password are the credentials anki-sync-username and anki-sync-password, never
# variables here.
DECKSTREAK_SYNC_ENDPOINT=

# The decks read (SPEC-023): a card is read when its home deck's top-level name starts with one of
# these prefixes, separated by commas. Empty or unset reads every deck. A deployment's own deck
# names are private configuration; the example is neutral.
DECKSTREAK_INCLUDE_DECKS=Law,Language

# The top-level deck name the law track's decks start with, optional (SPEC-023). Unset, every card
# is on the language track. When the include list is set and no prefix of it covers this root, the
# service logs one warning at start naming both settings.
DECKSTREAK_LAW_DECK_ROOT=Law

# The address the API listens on (the `api` role). It must be a loopback address, 127.0.0.0/8 or
# [::1], with a port: the API is reached only through the reverse proxy on the same host (ADR-007).
# Required.
DECKSTREAK_API_LISTEN=127.0.0.1:8080

# The directory systemd passes a unit with StateDirectory=: the database lives in it as
# deck_streak.db (ADR-008), and the copy of the collection and its lock beside it (SPEC-022).
# systemd sets it; set it by hand only to point a local run at a directory of its own. Required by
# every role that opens the database or syncs.
STATE_DIRECTORY=

# How old Telegram's launch data may be when the Mini App opens a session, in whole seconds, 1 to
# 86400 (the `api` role; ADR-024). Default 3600. Launch data dated more than 60 seconds ahead of
# the server's clock is refused as clock skew, whatever this bound.
DECKSTREAK_INIT_DATA_MAX_AGE_SECONDS=3600

# The vault root: an absolute directory path, required by the vault features. It is private
# configuration of the deployment, so no example is given.
DECKSTREAK_VAULT_ROOT=

# The readings folder at the vault's top level, and the archive folder inside it: one folder name
# each, required. The adapter never creates the readings folder; the operator makes it.
DECKSTREAK_VAULT_READINGS_FOLDER=12-Readings
DECKSTREAK_VAULT_ARCHIVE_FOLDER=Archive

# The Mini App's https: URL, which the bot's /start button opens (the `bot` role; SPEC-026).
# Required by the bot. A deployment's own host name is private configuration; the example is
# neutral.
DECKSTREAK_MINI_APP_URL=https://deckstreak.example/app

# The Bot API's base URL, without the token (the `bot` role; SPEC-026). Unset, it is Telegram's own,
# https://api.telegram.org; set, it must be https:, or http: to a loopback host, such as a local Bot
# API server.
DECKSTREAK_BOT_API_URL=

# The owner's courses: an absolute path to a private JSON file of the schema deckstreak.courses.v1
# (ADR-087, SPEC-071 R1), whose shape deploy/config/courses.example.json shows with neutral values.
# The courses are private configuration, so no example path is given. Unset, no card has a course,
# and the start says so once.
DECKSTREAK_COURSES_FILE=

# The lapses at which a card that is not suspended counts as a leech in a day's card snapshot,
# 1 to 1000 (SPEC-071 R8). Default 8, the predecessor's.
DECKSTREAK_LEECH_THRESHOLD=8
