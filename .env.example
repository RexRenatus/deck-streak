# DeckStreak's settings, by name (SPEC-020 R22, SPEC-025 R10). Copy this file to .env for a local run; .env is
# never committed. A setting left unset takes the default its comment names. A secret is never a
# variable here: it reaches a process as a systemd credential (ADR-010).

# The hour the study day turns over, 0 to 23. Default 4.
DECKSTREAK_ROLLOVER_HOUR=4

# The fixed offset from UTC the rollover hour is local to, in whole minutes, -720 to 840. Default 0;
# a deployment's own offset is private configuration.
DECKSTREAK_UTC_OFFSET_MINUTES=0

# The hour the daily digest goes out, 0 to 23, never before the rollover hour. Unset, it is the
# larger of 9 and the rollover hour.
DECKSTREAK_DIGEST_HOUR=

# How many blocking operations run at once, 1 to 512. Default 1.
DECKSTREAK_OFFLOAD_WORKERS=1

# The log level, in tracing's filter directives. Default info.
RUST_LOG=info

# The directory systemd passes a unit's credentials in (LoadCredential=). systemd sets it; set it
# by hand only to point a local run at a directory of synthetic credentials.
CREDENTIALS_DIRECTORY=

# The Anki sync server's URL, http: or https:, required (SPEC-022). A deployment's own URL is
# private configuration; a plain http: URL sends the sync credentials in the clear. The account's
# username and password are the credentials anki-sync-username and anki-sync-password, never
# variables here.
DECKSTREAK_SYNC_ENDPOINT=

# The address the API listens on (the `api` role). It must be a loopback address, 127.0.0.0/8 or
# [::1], with a port: the API is reached only through the reverse proxy on the same host (ADR-007).
# Required.
DECKSTREAK_API_LISTEN=127.0.0.1:8080

# The directory systemd passes a unit with StateDirectory=: the database lives in it as
# deck_streak.db (ADR-008), and the copy of the collection and its lock beside it (SPEC-022).
# systemd sets it; set it by hand only to point a local run at a directory of its own. Required by
# every role that opens the database or syncs.
STATE_DIRECTORY=
