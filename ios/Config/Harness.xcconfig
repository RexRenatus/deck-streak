// The harness's build settings (SPEC-339 R13, ADR-350). The TestFlight lanes inherit them
// (SPEC-352 R9, ADR-363): a lane's sign step writes the real app id and its signing into the
// ignored Signing.local.xcconfig, included last, and passes the build number, the version and
// the lane on its own command line. A person building locally puts their own in that same file.

// The bundle id is read from one setting. Its committed value is a reserved name (RFC 2606's
// `.invalid`, written reversed) that no account can register and no upload can carry.
PRODUCT_BUNDLE_IDENTIFIER = $(DS_APP_ID)
DS_APP_ID = invalid.deckstreak.harness

// The Info.plist reads both; the lane overrides them.
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.0.0

DEAD_CODE_STRIPPING = YES

#include? "Signing.local.xcconfig"
