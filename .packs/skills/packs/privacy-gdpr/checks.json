{
  "schema": "phx.skills.checks.v1",
  "spec": "SPEC-V2-2222",
  "pack": "packs/privacy-gdpr",
  "walk": [
    "inventory",
    "rights",
    "design",
    "public"
  ],
  "paths": [
    "skills/packs/privacy-gdpr/*",
    "scripts/privacy-gdpr-probe.py",
    "scripts/persona-core-probe.py",
    "skills/packs/persona-core/*"
  ],
  "note": "SPEC-V2-2222. Fifteen tree rows, one per privacy-gdpr-probe.py class, each run from the skills directory against any --root that holds a privacy.json inventory: the GDPR record (Arts 5, 6, 30), the data subject's rights (Arts 13, 15, 17, 20), privacy by design and default (Art. 25) with Telegram's data rules, and the public-repository scrubber, which composes with persona-core's deny list through its load_deny(). logs-pseudonymised is advisory: it reports and never refuses.",
  "checks": [
    {
      "id": "inventory-valid",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/privacy-gdpr-probe.py",
          "--root",
          "{root}",
          "check",
          "inventory-valid"
        ],
        "timeout_seconds": 120
      },
      "stage": "inventory",
      "reason": "inventory-invalid",
      "scope": "tree"
    },
    {
      "id": "schema-covered",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/privacy-gdpr-probe.py",
          "--root",
          "{root}",
          "check",
          "schema-covered"
        ],
        "timeout_seconds": 120
      },
      "stage": "inventory",
      "reason": "personal-data-undeclared",
      "scope": "tree"
    },
    {
      "id": "retention-bounded",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
