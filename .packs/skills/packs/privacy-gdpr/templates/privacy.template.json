{
  "schema": "phx.privacy.v1",
  "categories": [
    {
      "id": "account",
      "data": "Telegram user id, first name and language code",
      "source": "telegram-initdata",
      "stores": ["users.*"],
      "purpose": "signing the learner in and addressing them by name",
      "lawful_basis": "contract",
      "retention": {"until": "account-deletion"},
      "export": true,
      "erase": "delete"
    },
    {
      "id": "study-history",
      "data": "review sessions and their results",
      "source": "study-activity",
      "stores": ["study_sessions.*"],
      "purpose": "scheduling reviews and showing progress",
      "lawful_basis": "contract",
      "retention": {"period": "P2Y", "after": "collection"},
      "export": true,
      "erase": "delete"
    },
    {
      "id": "preferences",
      "data": "the Mini App settings the learner chose",
      "source": "telegram-storage",
      "stores": ["cloudstorage:theme"],
      "purpose": "remembering the learner's settings",
      "lawful_basis": "consent",
      "withdraw": "/privacy",
      "retention": {"until": "consent-withdrawal"},
      "export": true,
      "erase": "delete"
    }
  ],
  "sql": ["migrations/*.sql"],
  "code": ["crates/*/src/**/*.rs", "web/src/**/*.ts", "web/src/**/*.svelte"],
  "export": {"code": ["crates/privacy/src/export.rs"], "format": "json"},
  "erase": {"code": ["crates/privacy/src/erase.rs", "web/src/lib/privacy/erase.ts"]},
  "purge": {"code": ["crates/privacy/src/purge.rs"], "timer": "deploy/deckstreak-purge.timer"},
  "backups": {"config": "deploy/litestream.yml", "retention": "P2D"},
  "logs": {"config": "deploy/journald/deckstreak.conf", "retention": "P14D"},
  "policy": {
    "file": "PRIVACY.md",
    "entry": [{"file": "crates/bot/src/commands.rs", "text": "\"privacy\""}]
  },
  "config": ["config/default.toml"],
  "public": {"allow": []},
  "private": ["config/private/**"]
}
