{
  "schema": "phx.persona.patterns.v1",
  "spec": "SPEC-V2-2212",
  "note": "The data behind no-dates, no-human-claim and voice. Each pattern is a Python re regex, matched line by line on NFKC-normalised text; flags 'i' is IGNORECASE. Han and Hangul patterns carry no word boundary, because CJK characters are word characters to re and no boundary falls inside a CJK run. A new language adds rows here, never code.",
  "dates": [
    {
      "id": "rfc3339-full-date",
      "lang": "*",
      "flags": "",
      "regex": "(?<![0-9])[0-9]{4}-(?:0?[1-9]|1[0-2])-(?:0?[1-9]|[12][0-9]|3[01])(?![0-9])",
      "what": "an RFC 3339 full-date, year-month-day"
    },
    {
      "id": "year-first-numeric",
      "lang": "*",
      "flags": "",
      "regex": "(?<![0-9])[0-9]{4}(?:/|\\. ?)(?:0?[1-9]|1[0-2])(?:/|\\. ?)(?:0?[1-9]|[12][0-9]|3[01])\\.?(?![0-9])",
      "what": "a year-first numeric date with slashes or dots, as CLDR writes it for zh, ja and ko"
    },
    {
      "id": "korean-short-numeric",
      "lang": "ko",
      "flags": "",
      "regex": "(?<![0-9])[0-9]{2}\\. (?:0?[1-9]|1[0-2])\\. (?:0?[1-9]|[12][0-9]|3[01])\\.",
      "what": "CLDR's Korean short date, yy. M. d."
    },
    {
      "id": "slash-numeric",
      "lang": "*",
      "flags": "",
      "regex": "(?<![0-9/])(?:0?[1-9]|[12][0-9]|3[01])/(?:0?[1-9]|[12][0-9]|3[01])/(?:[0-9]{4}|[0-9]{2})(?![0-9/])",
      "what": "a day-month or month-day numeric date with slashes, two- or four-digit year"
    },
    {
      "id": "dot-dash-numeric",
      "lang": "*",
      "flags": "",
      "regex": "(?<![0-9.\\-])(?:0?[1-9]|[12][0-9]|3[01])([.\\-])(?:0?[1-9]|[12][0-9]|3[01])\\1[0-9]{4}(?![0-9])",
      "what": "a day-month numeric date with dots or dashes and a four-digit year"
    },
    {
      "id": "en-month-day",
      "lang": "en",
      "flags": "",
      "regex": "\\b(?:January|February|March|April|May|June|July|August|September|October|November|December|(?:Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)\\.?)\\s+(?:0?[1-9]|[12][0-9]|3[01])(?:st|nd|rd|th)?\\b",
      "what": "an English month name and a day"
    },
    {
      "id": "en-day-month",
      "lang": "en",
      "flags": "",
      "regex": "\\b(?:0?[1-9]|[12][0-9]|3[01])(?:st|nd|rd|th)?\\s+(?:of\\s+)?(?:January|February|March|April|May|June|July|August|September|October|November|December|(?:Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)\\.?)(?![a-z])",
      "what": "a day and an English month name"
    },
    {
      "id": "en-month-year",
      "lang": "en",
      "flags": "",
      "regex": "\\b(?:January|February|March|April|May|June|July|August|September|October|November|December|(?:Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)\\.?),?\\s+[0-9]{4}\\b",
      "what": "an English month name and a year"
    },
    {
      "id": "fr-day-month",
      "lang": "fr",
      "flags": "i",
      "regex": "\\b(?:1er|(?:0?[1-9]|[12][0-9]|3[01]))\\s+(?:janvier|février|fevrier|mars|avril|mai|juin|juillet|août|aout|septembre|octobre|novembre|décembre|decembre)\\b",
      "what": "a day and a French month name"
    },
    {
      "id": "fr-month-year",
      "lang": "fr",
      "flags": "i",
      "regex": "\\b(?:janvier|février|fevrier|mars|avril|mai|juin|juillet|août|aout|septembre|octobre|novembre|décembre|decembre)\\s+[0-9]{4}\\b",
      "what": "a French month name and a year"
    },
    {
      "id": "es-day-month",
      "lang": "es",
      "flags": "i",
      "regex": "\\b(?:0?[1-9]|[12][0-9]|3[01])\\s+de\\s+(?:enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|setiembre|octubre|noviembre|diciembre)\\b",
      "what": "a day and a Spanish month name"
    },
    {
      "id": "es-month-year",
      "lang": "es",
      "flags": "i",
      "regex": "\\b(?:enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|setiembre|octubre|noviembre|diciembre)\\s+del?\\s+[0-9]{4}\\b",
      "what": "a Spanish month name and a year"
    },
    {
      "id": "han-year-month",
      "lang": "zh,ja",
      "flags": "",
      "regex": "[0-9〇零一二三四五六七八九十百千两]{2,4}\\s*年\\s*[0-9〇零一二三四五六七八九十百千两]{1,3}\\s*月(?![份个個か])",
      "what": "a year and a month in Han characters (年 then 月)"
    },
    {
      "id": "han-month-day",
      "lang": "zh,ja",
      "flags": "",
      "regex": "[0-9〇零一二三四五六七八九十百千两]{1,3}\\s*月\\s*[0-9〇零一二三四五六七八九十百千两]{1,3}\\s*[日号號]",
      "what": "a month and a day in Han characters (月 then 日 or 号)"
    },
    {
      "id": "hangul-year-month",
      "lang": "ko",
      "flags": "",
      "regex": "[0-9]{2,4}\\s*년\\s*[0-9]{1,2}\\s*월(?!\\s*[0-9]*\\s*개)",
      "what": "a year and a month in Korean (년 then 월)"
    },
    {
      "id": "hangul-month-day",
      "lang": "ko",
      "flags": "",
      "regex": "[0-9]{1,2}\\s*월\\s*[0-9]{1,2}\\s*일",
      "what": "a month and a day in Korean (월 then 일)"
    }
  ],
  "timelines": [
    {
      "id": "en-countdown-left",
      "lang": "en",
      "flags": "i",
      "regex": "\\b[0-9]+\\s+(?:more\\s+)?(?:days?|weeks?|months?|years?|sleeps)\\s+(?:left|remaining|to\\s+go)\\b",
      "what": "a calendar-scale countdown: N days, weeks, months or years left"
    },
    {
      "id": "en-until-the-exam",
      "lang": "en",
      "flags": "i",
      "regex": "\\b[0-9]+\\s+(?:days?|weeks?|months?|years?)\\s+(?:left\\s+)?(?:until|till|before|to)\\s+(?:the|your)\\s+(?:exam|test|bar|lsat|deadline|big\\s+day)\\b",
      "what": "N days, weeks or months until the exam or a deadline"
    },
    {
      "id": "en-deadline-stated",
      "lang": "en",
      "flags": "i",
      "regex": "\\b(?:deadline|due\\s+date|exam\\s+date|test\\s+date|exam\\s+day|test\\s+day|sit\\s+date)\\s*(?:(?:is|was|will\\s+be|falls)\\s+|:\\s*)(?:on\\b|in\\b|at\\b|by\\b|this\\b|next\\b|tomorrow|today|tonight|soon|approaching|coming|monday|tuesday|wednesday|thursday|friday|saturday|sunday|january|february|march|april|may|june|july|august|september|october|november|december|[0-9])",
      "what": "a deadline or an exam date stated"
    },
    {
      "id": "en-countdown-stated",
      "lang": "en",
      "flags": "i",
      "regex": "\\bcount(?:ing)?\\s*down\\s+(?:to|until|the\\s+days)\\b|\\bcountdown\\s*(?:to|until|:)",
      "what": "a countdown stated"
    },
    {
      "id": "en-t-minus",
      "lang": "en",
      "flags": "i",
      "regex": "\\bT-minus\\b",
      "what": "T-minus countdown notation"
    },
    {
      "id": "en-due-by",
      "lang": "en",
      "flags": "i",
      "regex": "\\b(?:due|submit(?:ted)?|finish(?:ed)?|complete(?:d)?|done|ready)\\s+by\\s+(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday|tomorrow|tonight|next\\s+(?:week|month|year)|the\\s+end\\s+of\\s+(?:the\\s+)?(?:day|week|month|year)|january|february|march|april|may|june|july|august|september|october|november|december)\\b",
      "what": "a deadline: due, submitted or finished by a day"
    },
    {
      "id": "en-schedule-position",
      "lang": "en",
      "flags": "i",
      "regex": "\\b(?:week|day|month)\\s+[0-9]+\\s+of\\s+[0-9]+\\b|\\b[0-9]+-(?:day|week|month)\\s+(?:plan|schedule|countdown|programme|program|sprint|streak\\s+plan)\\b",
      "what": "a schedule position (week N of M) or an N-week plan"
    },
    {
      "id": "fr-reste-jours",
      "lang": "fr",
      "flags": "i",
      "regex": "\\bil\\s+(?:te|vous|nous|leur|lui)?\\s*reste\\s+[0-9]+\\s+(?:jours?|semaines?|mois|ans?)\\b|\\bplus\\s+que\\s+[0-9]+\\s+(?:jours?|semaines?|mois)\\b",
      "what": "a French countdown: il reste N jours"
    },
    {
      "id": "fr-compte-a-rebours",
      "lang": "fr",
      "flags": "i",
      "regex": "\\bcompte\\s+à\\s+rebours\\s*(?::|jusqu|avant|pour)",
      "what": "a French countdown stated"
    },
    {
      "id": "fr-date-limite",
      "lang": "fr",
      "flags": "i",
      "regex": "\\b(?:date\\s+limite|échéance|date\\s+de\\s+l['’]examen|date\\s+du\\s+concours)\\s*(?:est|sera|tombe|:)",
      "what": "a French deadline or exam date stated"
    },
    {
      "id": "fr-j-moins",
      "lang": "fr",
      "flags": "",
      "regex": "(?<![A-Za-z])J\\s?-\\s?[0-9]{1,3}\\b",
      "what": "French J-N countdown notation"
    },
    {
      "id": "es-faltan-dias",
      "lang": "es",
      "flags": "i",
      "regex": "\\b(?:te|le|les|nos|os)?\\s*(?:quedan|faltan)\\s+[0-9]+\\s+(?:días|dias|semanas|meses|años)\\b",
      "what": "a Spanish countdown: faltan N días"
    },
    {
      "id": "es-cuenta-regresiva",
      "lang": "es",
      "flags": "i",
      "regex": "\\bcuenta\\s+(?:regresiva|atrás|atras)\\s*(?::|para|hasta|hacia)",
      "what": "a Spanish countdown stated"
    },
    {
      "id": "es-fecha-limite",
      "lang": "es",
      "flags": "i",
      "regex": "\\b(?:fecha\\s+l[íi]mite|fecha\\s+del\\s+examen|plazo)\\s*(?:es|será|sera|vence|termina|:)",
      "what": "a Spanish deadline or exam date stated"
    },
    {
      "id": "zh-countdown",
      "lang": "zh",
      "flags": "",
      "regex": "倒计时\\s*(?:[:：]|[0-9〇零一二三四五六七八九十百千两])|倒數\\s*(?:[:：]|[0-9〇零一二三四五六七八九十百千两])",
      "what": "a Chinese countdown stated"
    },
    {
      "id": "zh-until-exam",
      "lang": "zh",
      "flags": "",
      "regex": "(?:距离?|离)[^。！？\\n]{0,15}(?:考试|考試|截止|期限)[^。！？\\n]{0,6}(?:还有|還有|仅剩|僅剩|只剩)",
      "what": "time left until an exam or a deadline, in Chinese"
    },
    {
      "id": "zh-deadline-stated",
      "lang": "zh",
      "flags": "",
      "regex": "(?:截止日期|截止时间|截止時間|考试日期|考試日期|考试时间|考試時間)\\s*(?:是|为|為|定于|定於|[:：])",
      "what": "a Chinese deadline or exam date stated"
    },
    {
      "id": "ja-until-exam",
      "lang": "ja",
      "flags": "",
      "regex": "(?:試験|締め?切り?|締切|本番)まで(?:あと|残り)\\s*[0-9〇零一二三四五六七八九十百千两]+\\s*(?:日|週間|か月|ヶ月|カ月)",
      "what": "time left until an exam or a deadline, in Japanese"
    },
    {
      "id": "ja-deadline-stated",
      "lang": "ja",
      "flags": "",
      "regex": "(?:試験日|締め?切り?日?|締切日?)\\s*(?:は|[:：])",
      "what": "a Japanese deadline or exam date stated"
    },
    {
      "id": "ja-countdown",
      "lang": "ja",
      "flags": "",
      "regex": "カウントダウン\\s*(?:[:：]|[0-9])",
      "what": "a Japanese countdown stated"
    },
    {
      "id": "ko-until-exam",
      "lang": "ko",
      "flags": "",
      "regex": "(?:시험|마감)까지\\s*[0-9]+\\s*(?:일|주|개월)\\s*남",
      "what": "time left until an exam or a deadline, in Korean"
    },
    {
      "id": "ko-deadline-stated",
      "lang": "ko",
      "flags": "",
      "regex": "(?:마감일|시험일|시험\\s*날짜)\\s*(?:은|는|이|[:：])",
      "what": "a Korean deadline or exam date stated"
    },
    {
      "id": "ko-d-day",
      "lang": "ko",
      "flags": "",
      "regex": "(?<![A-Za-z0-9])D-[0-9]{1,3}(?![0-9])(?!\\s*(?:visa|비자))",
      "what": "D-N countdown notation"
    },
    {
      "id": "ko-countdown",
      "lang": "ko",
      "flags": "",
      "regex": "카운트다운\\s*(?:[:：]|[0-9])",
      "what": "a Korean countdown stated"
    }
  ],
  "human_claims": [
    {
      "id": "en-human",
      "lang": "en",
      "flags": "i",
      "regex": "\\bI(?:'m|’m|\\s+am)\\s+(?:a\\s+)?(?:real\\s+)?human(?:\\s+being)?\\b|\\bI(?:'m|’m|\\s+am)\\s+a\\s+real\\s+person\\b",
      "what": "the persona claims to be human"
    },
    {
      "id": "en-not-ai",
      "lang": "en",
      "flags": "i",
      "regex": "\\bI(?:'m|’m|\\s+am)\\s+not\\s+(?:an?\\s+)?(?:AI|A\\.I\\.|bot|chatbot|robot|machine|computer|program|language\\s+model|artificial\\s+intelligence)\\b",
      "what": "the persona denies being an AI"
    },
    {
      "id": "fr-human",
      "lang": "fr",
      "flags": "i",
      "regex": "\\bje\\s+suis\\s+(?:un\\s+|une\\s+)?(?:être\\s+humain|humaine?|vraie?\\s+personne)\\b|\\bje\\s+ne\\s+suis\\s+pas\\s+(?:une?\\s+)?(?:IA|intelligence\\s+artificielle|robot|machine|programme|chatbot)\\b",
      "what": "the persona claims to be human, in French"
    },
    {
      "id": "es-human",
      "lang": "es",
      "flags": "i",
      "regex": "\\b(?:yo\\s+)?soy\\s+(?:un\\s+|una\\s+)?(?:ser\\s+humano|humana?|persona\\s+real)\\b|\\bno\\s+soy\\s+(?:una?\\s+)?(?:IA|inteligencia\\s+artificial|robot|m[áa]quina|programa|chatbot)\\b",
      "what": "the persona claims to be human, in Spanish"
    },
    {
      "id": "zh-human",
      "lang": "zh",
      "flags": "",
      "regex": "我不是(?:AI|人工智能|机器人|機器人|程序|程式|聊天机器人|聊天機器人)|我是(?:真人|人类|人類)(?![学學])",
      "what": "the persona claims to be human, in Chinese"
    },
    {
      "id": "ja-human",
      "lang": "ja",
      "flags": "",
      "regex": "(?:私|わたし|僕|ぼく)は(?:AI|人工知能|ロボット|機械|プログラム)(?:では|じゃ)(?:ありません|ない)|(?:私|わたし|僕|ぼく)は(?:本物の)?人間です",
      "what": "the persona claims to be human, in Japanese"
    },
    {
      "id": "ko-human",
      "lang": "ko",
      "flags": "",
      "regex": "(?:저는|나는)\\s*(?:AI|인공지능|로봇|기계|프로그램)(?:가|이)\\s*아(?:니|닙|닌)|(?:저는|나는)\\s*(?:진짜\\s*)?인간(?:입니다|이에요|이야)",
      "what": "the persona claims to be human, in Korean"
    }
  ],
  "voice": [
    {
      "id": "stage-direction",
      "lang": "*",
      "flags": "i",
      "regex": "\\*(?:\\w+\\s+){0,3}(?:smiles?|smiling|grins?|grinning|laughs?|laughing|chuckles?|chuckling|sighs?|sighing|nods?|nodding|winks?|winking|beams?|beaming|shrugs?|shrugging|frowns?|frowning|gasps?|giggles?|giggling|adjusts\\s+\\w+|leans\\s+\\w+|clears\\s+(?:his|her|their|my)\\s+throat|pauses?|claps?|waves?|bows?)\\b[^*\\n]{0,40}\\*|[(\\[](?:smiles?|smiling|grins?|grinning|laughs?|laughing|chuckles?|chuckling|sighs?|sighing|nods?|nodding|winks?|winking|beams?|beaming|shrugs?|shrugging|frowns?|frowning|gasps?|giggles?|giggling|adjusts\\s+\\w+|leans\\s+\\w+|clears\\s+(?:his|her|their|my)\\s+throat|pauses?|claps?|waves?|bows?)[^)\\]\\n]{0,40}[)\\]]|[（(](?:笑|微笑|ため息|叹气|嘆氣|웃음|미소|한숨)[）)]",
      "what": "a roleplay stage direction"
    },
    {
      "id": "en-backstory",
      "lang": "en",
      "flags": "i",
      "regex": "\\bwhen\\s+I\\s+was\\s+(?:a\\s+(?:child|kid|boy|girl|student|teenager)|young|little|growing\\s+up)\\b|\\bI\\s+grew\\s+up\\s+(?:in|on|near)\\b|\\bback\\s+in\\s+my\\s+(?:day|village|hometown|school)\\b|\\bmy\\s+(?:grandmother|grandfather|grandma|grandpa|mother|father|mom|dad|wife|husband|children|kids)\\s+(?:used\\s+to|always|once|taught)\\b|\\bin\\s+my\\s+(?:childhood|youth)\\b",
      "what": "an invented personal backstory"
    },
    {
      "id": "fr-backstory",
      "lang": "fr",
      "flags": "i",
      "regex": "\\bquand\\s+j['’]étais\\s+(?:petite?|enfant|jeune|étudiante?|adolescente?)\\b|\\b(?:mon\\s+(?:grand-père|père)|ma\\s+(?:grand-mère|mère))\\s+(?:me\\s+disait|m['’]a\\s+appris|disait\\s+toujours)\\b",
      "what": "an invented personal backstory, in French"
    },
    {
      "id": "es-backstory",
      "lang": "es",
      "flags": "i",
      "regex": "\\bcuando\\s+(?:yo\\s+)?era\\s+(?:niño|niña|joven|pequeño|pequeña|estudiante)\\b|\\bmi\\s+(?:abuela|abuelo|madre|padre)\\s+(?:me\\s+decía|siempre\\s+decía|solía)\\b",
      "what": "an invented personal backstory, in Spanish"
    },
    {
      "id": "zh-backstory",
      "lang": "zh",
      "flags": "",
      "regex": "我(?:小时候|小時候|年轻的时候|年輕的時候|上学的时候|上學的時候)",
      "what": "an invented personal backstory, in Chinese"
    },
    {
      "id": "ja-backstory",
      "lang": "ja",
      "flags": "",
      "regex": "(?:私|僕|わたし)が(?:子供|子ども|学生|若い)(?:の頃|のころ|だった頃|だったころ)",
      "what": "an invented personal backstory, in Japanese"
    },
    {
      "id": "ko-backstory",
      "lang": "ko",
      "flags": "",
      "regex": "(?:제가|내가)\\s*(?:어렸을\\s*때|어릴\\s*때|학생(?:이었을|일)\\s*때)",
      "what": "an invented personal backstory, in Korean"
    }
  ],
  "voice_limits": {
    "exclamations_min": 3,
    "units_per_exclamation": 40,
    "emoji_ranges": [
      [
        "1F300",
        "1FAFF"
      ],
      [
        "2600",
        "27BF"
      ],
      [
        "1F000",
        "1F2FF"
      ],
      [
        "1FB00",
        "1FBFF"
      ]
    ]
  }
}
