{
  "schema": "phx.skills.checks.v1",
  "spec": "SPEC-V2-2212",
  "pack": "packs/persona-core",
  "walk": [
    "schema",
    "safety",
    "voice"
  ],
  "paths": [
    "skills/packs/persona-core/*",
    "scripts/persona-core-probe.py",
    "*.persona.md"
  ],
  "note": "SPEC-V2-2212. Eight tree rows, one per persona-core-probe.py class, each run from the skills directory against any --root: the persona template schema v1, the persona output contract v1, duty composition, and the shared safety checks every persona pack reuses with --kind. voice is advisory: it reports and never refuses.",
  "checks": [
    {
      "id": "template-schema",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/persona-core-probe.py",
          "--root",
          "{root}",
          "check",
          "template-schema"
        ],
        "timeout_seconds": 120
      },
      "stage": "schema",
      "reason": "template-invalid",
      "scope": "tree"
    },
    {
      "id": "output-contract",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/persona-core-probe.py",
          "--root",
          "{root}",
          "check",
          "output-contract"
        ],
        "timeout_seconds": 120
      },
      "stage": "schema",
      "reason": "output-invalid",
      "scope": "tree"
    },
    {
      "id": "duty-composition",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/persona-core-probe.py",
          "--root",
          "{root}",
          "check",
          "duty-composition"
        ],
        "timeout_seconds": 120
      },
      "stage": "schema",
      "reason": "duty-sections-missing",
      "scope": "tree"
    },
    {
      "id": "no-dates",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/persona-core-probe.py",
          "--root",
          "{root}",
          "check",
          "no-dates"
        ],
        "timeout_seconds": 120
      },
      "stage": "safety",
      "reason": "date-or-timeline",
      "scope": "tree"
    },
    {
      "id": "scrubber",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/persona-core-probe.py",
          "--root",
          "{root}",
          "check",
          "scrubber"
        ],
        "timeout_seconds": 120
      },
      "stage": "safety",
      "reason": "scrubber-denied",
      "scope": "tree"
    },
    {
      "id": "memory-scope",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/persona-core-probe.py",
          "--root",
          "{root}",
          "check",
          "memory-scope"
        ],
        "timeout_seconds": 120
      },
      "stage": "safety",
      "reason": "memory-out-of-scope",
      "scope": "tree"
    },
    {
      "id": "no-human-claim",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/persona-core-probe.py",
          "--root",
          "{root}",
          "check",
          "no-human-claim"
        ],
        "timeout_seconds": 120
      },
      "stage": "safety",
      "reason": "human-claim",
      "scope": "tree"
    },
    {
      "id": "voice",
      "severity": "advisory",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/persona-core-probe.py",
          "--root",
          "{root}",
          "check",
          "voice"
        ],
        "timeout_seconds": 120
      },
      "stage": "voice",
      "reason": "voice-drift",
      "scope": "tree"
    }
  ]
}
