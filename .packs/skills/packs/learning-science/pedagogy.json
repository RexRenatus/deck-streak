    "reading",
    "drill",
    "remediation",
    "feedback",
    "dialogue",
    "practice"
  ],
  "duties": {
    "daily-reading": "reading",
    "drill-coach": "drill",
    "leech-doctor": "remediation",
    "writing-tutor": "feedback",
    "conversation-partner": "dialogue",
    "practice-questions": "practice"
  },
