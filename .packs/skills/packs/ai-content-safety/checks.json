{
  "schema": "phx.skills.checks.v1",
  "spec": "SPEC-V2-2222",
  "pack": "packs/ai-content-safety",
  "walk": [
    "injection",
    "output",
    "disclosure"
  ],
  "paths": [
    "skills/packs/ai-content-safety/*",
    "scripts/ai-content-safety-probe.py",
    "scripts/persona-core-probe.py",
    "skills/packs/persona-core/*",
    "scripts/law-professors-probe.py",
    "skills/packs/law-professors/*"
  ],
  "note": "SPEC-V2-2222. Eleven tree rows, one per ai-content-safety-probe.py class, each run from the skills directory against any --root that holds an ai-safety.json manifest: prompt injection (fenced, JSON-encoded untrusted slots, the stated policy, scoped agency, red-team cases), output validation (the gate, links, invisible text, the Art. 50(2) mark) and the Art. 50(1) disclosure. It composes with persona-core and law-professors through their probes' API and by requiring their classes in every task's gate; their bars stay theirs (one bar, one owner). output-echo is advisory: it reports and never refuses.",
  "checks": [
    {
      "id": "prompt-contract",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/ai-content-safety-probe.py",
          "--root",
          "{root}",
          "check",
          "prompt-contract"
        ],
        "timeout_seconds": 120
      },
      "stage": "injection",
      "reason": "prompt-invalid",
      "scope": "tree"
    },
    {
      "id": "untrusted-fenced",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/ai-content-safety-probe.py",
          "--root",
          "{root}",
          "check",
          "untrusted-fenced"
        ],
        "timeout_seconds": 120
      },
      "stage": "injection",
      "reason": "untrusted-unfenced",
      "scope": "tree"
    },
    {
      "id": "policy-stated",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/ai-content-safety-probe.py",
          "--root",
          "{root}",
          "check",
          "policy-stated"
        ],
        "timeout_seconds": 120
      },
      "stage": "injection",
      "reason": "policy-missing",
      "scope": "tree"
    },
    {
      "id": "agency-scoped",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/ai-content-safety-probe.py",
          "--root",
          "{root}",
          "check",
          "agency-scoped"
        ],
        "timeout_seconds": 120
      },
      "stage": "injection",
      "reason": "excessive-agency",
      "scope": "tree"
    },
    {
      "id": "redteam-present",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/ai-content-safety-probe.py",
          "--root",
          "{root}",
          "check",
          "redteam-present"
        ],
        "timeout_seconds": 120
      },
      "stage": "injection",
      "reason": "redteam-missing",
      "scope": "tree"
    },
    {
      "id": "output-gated",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/ai-content-safety-probe.py",
          "--root",
          "{root}",
          "check",
          "output-gated"
        ],
        "timeout_seconds": 120
      },
      "stage": "output",
      "reason": "output-ungated",
      "scope": "tree"
    },
    {
      "id": "output-links",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/ai-content-safety-probe.py",
          "--root",
          "{root}",
          "check",
          "output-links"
        ],
        "timeout_seconds": 120
      },
      "stage": "output",
      "reason": "link-not-allowed",
      "scope": "tree"
    },
    {
      "id": "output-invisible",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/ai-content-safety-probe.py",
          "--root",
          "{root}",
          "check",
          "output-invisible"
        ],
        "timeout_seconds": 120
      },
      "stage": "output",
      "reason": "invisible-text",
      "scope": "tree"
    },
    {
      "id": "output-marked",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/ai-content-safety-probe.py",
          "--root",
          "{root}",
          "check",
          "output-marked"
        ],
        "timeout_seconds": 120
      },
      "stage": "output",
      "reason": "output-unmarked",
      "scope": "tree"
    },
    {
      "id": "output-echo",
      "severity": "advisory",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/ai-content-safety-probe.py",
          "--root",
          "{root}",
          "check",
          "output-echo"
        ],
        "timeout_seconds": 120
      },
      "stage": "output",
      "reason": "prompt-echoed",
      "scope": "tree"
    },
    {
      "id": "disclosure-first-contact",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/ai-content-safety-probe.py",
          "--root",
          "{root}",
          "check",
          "disclosure-first-contact"
        ],
        "timeout_seconds": 120
      },
      "stage": "disclosure",
      "reason": "disclosure-missing",
      "scope": "tree"
    }
  ]
}
