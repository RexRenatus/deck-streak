{
  "schema": "phx.ai.vocabulary.v1",
  "spec": "SPEC-V2-2222",
  "note": "The vocabulary scripts/ai-content-safety-probe.py reads: which prompt sources are untrusted, which agent tools a task that reads untrusted text may hold, the red-team attack classes, the gate classes every AI output must pass, and the invisible characters an output may not carry. A new source, tool or attack is a row here, never a code branch.",
  "untrusted_sources": [
    "learner",
    "cards",
    "vault",
    "memory",
    "stats",
    "web",
    "tool-output",
    "telegram",
    "upload"
  ],
  "trusted_sources": ["rules", "template", "duty", "config"],
  "formats": ["persona", "other"],
  "on_invalid": ["withhold", "degrade", "retry"],
  "filters": ["json"],
  "read_tools": ["Read", "Grep", "NotebookRead"],
  "list_tools": ["Glob", "LS", "TodoWrite"],
  "write_tools": ["Write", "Edit", "MultiEdit", "NotebookEdit"],
  "open_tools": ["WebFetch", "WebSearch", "Task", "Agent"],
  "shell_tools": ["Bash"],
  "unscoped_paths": ["", "*", "**", "/", "/*", "/**", "~", "~/*", "~/**", "//**", "./**", "."],
  "egress_programs": [
    "curl",
    "wget",
    "nc",
    "ncat",
    "netcat",
    "socat",
    "ssh",
    "scp",
    "sftp",
    "rsync",
    "ftp",
    "telnet",
    "git",
    "gh",
    "npm",
    "npx",
    "pnpm",
    "yarn",
    "pip",
    "pip3",
    "uv",
    "cargo",
    "python",
    "python3",
    "node",
    "deno",
    "bun",
    "bash",
    "sh",
    "zsh",
    "dig",
    "nslookup",
    "host",
    "ping",
    "openssl",
    "gcloud",
    "aws",
    "az",
    "kubectl",
    "docker",
    "env",
    "eval",
    "xargs",
    "sudo"
  ],
  "attacks": [
    "instruction-override",
    "fence-breakout",
    "exfil-link",
    "invisible-text",
    "persona-override",
    "tool-misuse"
  ],
  "required_attacks": ["instruction-override", "fence-breakout", "exfil-link"],
  "expects": ["ignored", "withheld"],
  "required_gates": {
    "all": [
      "ai-content-safety:output-links",
      "ai-content-safety:output-invisible",
      "ai-content-safety:output-marked"
    ],
    "persona": [
      "persona-core:output-contract",
      "persona-core:no-dates",
      "persona-core:scrubber",
      "persona-core:no-human-claim",
      "persona-core:memory-scope"
    ],
    "law": [
      "law-professors:rule-cites-corpus",
      "law-professors:citations-resolve",
      "law-professors:quotes-grounded",
      "law-professors:authority-grounded"
    ]
  },
  "invisible": {
    "allowed": ["200C", "200D"],
    "variation_selectors": [["FE00", "FE0F"], ["E0100", "E01EF"]],
    "max_variation_run": 1
  },
  "fence_markers": ["<untrusted", "</untrusted>", "<untrusted_content_policy>", "</untrusted_content_policy>"],
  "echo_min_chars": 60
}
