{
  "schema": "phx.skills.checks.v1",
  "pack": "packs/mutation-rows",
  "spec": "SPEC-V2-2208",
  "walk": [
    "rows",
    "practice"
  ],
  "paths": [
    "scripts/mutation-rows.json",
    "scripts/tests/_rows.py",
    "scripts/mutant-viability.py",
    "crates/phx-release/src/anchor_audit.rs",
    "crates/phxd/src/mutants.rs",
    "crates/phxd/src/bin/mutants-diff.rs",
    "crates/phxd/src/bin/mutation-rc*.rs",
    "scripts/mutation-rows.d/*.json",
    "scripts/mutation_rows.py",
    "scripts/row_target.py",
    "scripts/mutation-probe.py",
    ".github/workflows/*.yml"
  ],
  "note": "SPEC-V2-2162 seeded the rows stage and SPEC-V2-2208 grew the pack. The rows stage judges phoenix-v2's own row manifest and its guards: seven rows run existing guards, and find-differs, band-ids and mutants-distinct read the manifest through the tree's own scripts/mutation_rows.py. The practice stage judges any --root with scripts/mutation-probe.py: tool-config-valid blocks only what the tool itself refuses, and the eleven others are advisory.",
  "checks": [
    {
      "id": "anchor-audit",
      "severity": "block",
      "probe": {
        "command": [
          "cargo",
          "test",
          "--manifest-path",
          "{root}/Cargo.toml",
          "-p",
          "phxd",
          "--lib",
          "--",
          "the_anchor_audit"
        ],
        "timeout_seconds": 900
      },
      "stage": "rows",
      "reason": "anchor-audit_red",
      "scope": "tree"
    },
    {
      "id": "killer-selection",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "{root}/scripts/tests",
          "-p",
          "test_mutation_killer_selection.py"
        ],
        "timeout_seconds": 300
      },
      "stage": "rows",
      "reason": "killer-selection_red",
      "scope": "tree"
    },
    {
      "id": "one-selection-policy",
      "severity": "block",
      "probe": {
        "command": [
          "cargo",
          "test",
          "--manifest-path",
          "{root}/Cargo.toml",
          "-p",
          "phxd",
          "--test",
          "one_selection_policy"
        ],
        "timeout_seconds": 900
      },
      "stage": "rows",
      "reason": "one-selection-policy_red",
      "scope": "tree"
    },
    {
      "id": "rows-reader",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "{root}/scripts/tests",
          "-p",
          "test_rows_reader.py"
        ],
        "timeout_seconds": 120
      },
      "stage": "rows",
      "reason": "rows-reader_red",
      "scope": "tree"
    },
    {
      "id": "seal-digest-anchors",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "{root}/scripts/tests",
          "-p",
          "test_seal_digest_anchors.py"
        ],
        "timeout_seconds": 120
      },
      "stage": "rows",
      "reason": "seal-digest-anchors_red",
      "scope": "tree"
    },
    {
      "id": "mutant-viability",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{root}/scripts/mutant-viability.py"
        ],
        "timeout_seconds": 300
