      "stage": "rows",
      "reason": "mutant-viability_red",
      "scope": "tree"
    },
    {
      "id": "manifest-bytes",
      "severity": "block",
      "probe": {
        "command": [
          "cargo",
          "test",
          "--manifest-path",
          "{root}/Cargo.toml",
          "-p",
          "phx-release",
          "--test",
          "compose",
          "--",
          "--exact",
          "a_no_op_manifest_union_is_byte_identical"
        ],
        "timeout_seconds": 900
      },
      "stage": "rows",
      "reason": "manifest-bytes_red",
      "scope": "tree"
    },
    {
      "id": "find-differs",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/mutation-probe.py",
          "--root",
          "{root}",
          "check",
          "find-differs"
        ],
        "timeout_seconds": 120
      },
      "stage": "rows",
      "reason": "find-equals-replacement",
      "scope": "tree"
    },
    {
      "id": "band-ids",
