{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phxd.pack.probe.v1",
  "title": "phxd.pack.probe.v1",
  "type": "object",
  "required": ["schema", "spec", "pack", "color", "checks"],
  "properties": {
    "schema": { "const": "phxd.pack.probe.v1" },
    "spec": { "const": "SPEC-V2-1201" },
    "cites": { "type": "array", "items": { "type": "string" } },
    "pack": { "enum": ["web-launch", "vibecode-polish"] },
    "color": { "enum": ["green", "red"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ran", "exit", "color"],
        "properties": {
          "id": { "type": "string" },
          "ran": { "const": true },
          "exit": { "type": "integer" },
          "color": { "enum": ["green", "red"] }
        }
      }
    }
  }
}
