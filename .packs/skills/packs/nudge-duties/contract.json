{
  "schema": "phx.duty.nudge.contract.v1",
  "spec": "SPEC-V2-2217",
  "note": "The vocabularies of the nudge-duties message envelope v1. nudge-duties-probe.py reads this file; a new duty, role, tier or send key is a row here, never a code branch. Telegram's own grammar (HTML tags, entities, button fields, the 4096 limit) is NOT here: it has one home, the telegram-platform pack's probe, which this probe calls.",
  "message_schema": "phx.duty.message.v1",
  "claim_suffix": ".msg.json",
  "part_separator": "\n\n",
  "token": "^[a-z0-9][a-z0-9:._-]{0,127}$",
  "stat_key": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*$",
  "keys": {
    "always": [
      "schema",
      "duty",
      "kind",
      "tier",
      "dedupe_key",
      "parts",
      "send"
    ],
    "optional": [
      "budget_key",
      "lapse_id"
    ],
    "tokens": [
      "budget_key",
      "dedupe_key",
      "lapse_id",
      "reading_id"
    ]
  },
  "duties": [
    {
      "id": "daily-digest",
      "kind": "digest",
      "required": [
        "coaching",
        "stats_source",
        "stats"
      ],
      "roles": [
        "stats",
        "coaching",
        "notice",
        "readings",
        "invite"
      ],
      "required_roles": [
        "stats"
      ],
      "first_role": "stats"
    },
    {
      "id": "comeback",
      "kind": "comeback",
      "required": [
        "lapse_id",
        "reading_id"
      ],
      "roles": [
        "invite",
        "reading"
      ],
      "required_roles": [
        "invite"
      ],
      "first_role": null
    }
  ],
  "tiers": [
    "T0",
    "T1",
    "T2",
    "T3",
    "T4",
    "T5"
  ],
  "coaching": [
    "ok",
    "unavailable"
  ],
  "send": {
    "keys": [
      "text",
      "parse_mode",
      "reply_markup",
      "link_preview_options",
      "disable_notification",
      "protect_content"
    ],
    "parse_modes": [
      "HTML"
    ],
    "refused": {
      "entities": "the contract admits parse_mode HTML or plain text, never an entities list",
      "chat_id": "a chat id never belongs in a message file; the engine adds it at send time",
      "caption_entities": "the contract is a sendMessage text payload, never a caption"
    }
  },
  "keyboard": {
    "comeback_types": [
      "url",
      "web_app"
    ]
  }
}
