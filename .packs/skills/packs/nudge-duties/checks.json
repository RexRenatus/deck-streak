{
  "schema": "phx.skills.checks.v1",
  "spec": "SPEC-V2-2217",
  "pack": "packs/nudge-duties",
  "walk": [
    "contract",
    "telegram",
    "facts",
    "lapse",
    "ethics",
    "voice"
  ],
  "paths": [
    "skills/packs/nudge-duties/*",
    "scripts/nudge-duties-probe.py",
    "*.msg.json"
  ],
  "note": "SPEC-V2-2217. Sixteen tree rows, one per nudge-duties-probe.py class, each run from the skills directory against any --root: the message envelope v1 of the daily digest and the one-per-lapse comeback, the Telegram payload limits, the digest's facts, the lapse rules, and the owner's ethics rules. Twelve block and four advisory; the advisory rows report and never refuse. no-dates-or-countdowns, no-internals, no-shame-framing, digest-degraded, autonomy-language and near-miss-copy reuse persona-core's public load_patterns, load_deny and scan; no-journal-in-messages calls vault-duties' load_journal and journal_leaks.",
  "checks": [
    {
      "id": "message-contract",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/nudge-duties-probe.py",
          "--root",
          "{root}",
          "check",
          "message-contract"
        ],
        "timeout_seconds": 120
      },
      "stage": "contract",
      "reason": "message-invalid",
      "scope": "tree"
    },
    {
      "id": "telegram-length",
