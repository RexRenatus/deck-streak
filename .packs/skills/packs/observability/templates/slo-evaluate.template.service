# Runs slo-evaluate.template.py every five minutes (slo-evaluate.template.timer). It exits 1 when
# a page starts, so OnFailure= pages through the one alert path with its error lines.
[Unit]
Description=Evaluate the SLO burn rates
OnFailure=deckstreak-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/deckstreak/deploy/slo-evaluate.py /opt/deckstreak/deploy/slo.json
StateDirectory=deckstreak-slo
SupplementaryGroups=systemd-journal
MemoryMax=64M
