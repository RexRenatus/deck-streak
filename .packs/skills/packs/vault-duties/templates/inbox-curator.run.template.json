{
  "schema": "phx.duty.vault.run.v1",
  "duty": "inbox-curator",
  "layout": "{{layout}}",
  "vault_root": "{{vault_root}}",
  "vault": ["{{vault_path}}"],
  "inbox": [{"path": "90-Inbox/{{capture}}", "sha256": "{{capture_sha256}}"}],
  "ops": [
    {
      "op": "move",
      "from": "90-Inbox/{{capture}}",
      "to": "{{target_folder}}/{{capture}}",
      "sha256": "{{capture_sha256}}"
    }
  ]
}
