{
  "schema": "phx.skills.checks.v1",
  "spec": "SPEC-V2-2218",
  "pack": "packs/vault-duties",
  "walk": [
    "obsidian",
    "rails",
    "duty",
    "privacy",
    "practice"
  ],
  "paths": [
    "skills/packs/vault-duties/*",
    "scripts/vault-duties-probe.py",
    "*duty-run.json",
    "scripts/persona-core-probe.py",
    "skills/packs/persona-core/*"
  ],
  "note": "SPEC-V2-2218. Fifteen tree rows, one per vault-duties-probe.py class, each run from the skills directory against any --root: the staged output of DeckStreak's daily note, weekly synthesis and inbox curator, judged before it reaches the owner's Obsidian vault. The practice rows are advisory: they report and never refuse.",
  "checks": [
    {
      "id": "note-properties",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/vault-duties-probe.py",
          "--root",
          "{root}",
          "check",
          "note-properties"
        ],
        "timeout_seconds": 120
      },
      "stage": "obsidian",
      "reason": "properties-invalid",
      "scope": "tree"
    },
    {
      "id": "note-links",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/vault-duties-probe.py",
          "--root",
          "{root}",
          "check",
          "note-links"
        ],
        "timeout_seconds": 120
      },
      "stage": "obsidian",
      "reason": "link-unresolved",
      "scope": "tree"
    },
    {
      "id": "note-names",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/vault-duties-probe.py",
          "--root",
          "{root}",
          "check",
          "note-names"
        ],
        "timeout_seconds": 120
      },
      "stage": "obsidian",
      "reason": "name-off-rule",
      "scope": "tree"
    },
    {
      "id": "write-confinement",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/vault-duties-probe.py",
          "--root",
          "{root}",
          "check",
          "write-confinement"
        ],
        "timeout_seconds": 120
      },
      "stage": "rails",
      "reason": "write-outside-agent-folders",
      "scope": "tree"
    },
    {
      "id": "no-executable",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/vault-duties-probe.py",
          "--root",
