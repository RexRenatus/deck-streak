{
  "schema": "phx.language-mentors.table.v1",
  "spec": "SPEC-V2-2213",
  "about": "The language-mentors pack's per-language rules, as data. scripts/language-mentors-probe.py interprets every entry and branches on no language code. The CEFR band-to-mode map is not here: it is read from skills/packs/persona-core/contract.json. Each entry names its source in SPEC-V2-2213's coverage matrix.",
  "instruction_language": "en",
  "material_sections": [
    "reading",
    "reply"
  ],
  "ratio": {
    "about": "The target language's share of the instruction text, counted in word units, for each persona-core CEFR mode. The reading and the reply are target-language material and are not instruction. Blockquotes, code and headings are not measured.",
    "english-led": {
      "min": 0.0,
      "max": 0.5
    },
    "bilingual": {
      "min": 0.15,
      "max": 0.85
    },
    "target-only": {
      "min": 0.95,
      "max": 1.0
    }
  },
  "density": {
    "about": "At most 5% of the reading is glossed new words: Laufer's 95% coverage (advisory).",
    "max_new_share": 0.05
  },
  "focus": {
    "about": "Focused written corrective feedback treats at most three error categories (advisory).",
    "max_categories": 3
  },
  "template": {
    "about": "What every language mentor template declares beyond persona-core's schema: the owner's four extras on the daily reading, and the writing habit folded in as the writing tutor.",
    "duties": [
      "daily-reading",
      "writing-tutor"
    ],
    "sections": {
      "daily-reading": [
        "glosses",
        "grammar",
        "pronunciation",
        "culture"
      ],
      "writing-tutor": [
        "focus"
      ]
    }
  },
