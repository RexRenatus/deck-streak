    {
      "id": "study-duty-templates",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/study-duties-probe.py",
          "--root",
          "{root}",
          "check",
          "study-duty-templates"
        ],
        "timeout_seconds": 120
      },
      "stage": "contract",
      "reason": "duty-template-invalid",
      "scope": "tree"
    },
