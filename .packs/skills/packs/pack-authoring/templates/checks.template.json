{
  "schema": "phx.skills.checks.v1",
  "spec": "SPEC-0000",
  "pack": "packs/example-pack",
  "walk": [
    "example"
  ],
  "paths": [
    "docs/*"
  ],
  "note": "SPEC-0000. Two tree rows, one per example-probe.py class, each run from the skills directory against any --root. example-length is advisory: it reports and never refuses.",
  "checks": [
    {
      "id": "example-title",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/example-probe.py",
          "--root",
          "{root}",
          "check",
          "example-title"
        ],
        "timeout_seconds": 60
      },
      "stage": "example",
      "reason": "title-missing",
      "scope": "tree"
    },
    {
      "id": "example-length",
      "severity": "advisory",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/example-probe.py",
          "--root",
          "{root}",
          "check",
          "example-length"
        ],
        "timeout_seconds": 60
      },
      "stage": "example",
      "reason": "page-too-long",
      "scope": "tree"
    }
  ]
}
