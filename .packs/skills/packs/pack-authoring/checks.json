{
  "schema": "phx.skills.checks.v1",
  "spec": "SPEC-V2-2210",
  "pack": "packs/pack-authoring",
  "walk": [
    "body",
    "skill",
    "spec",
    "catalog"
  ],
  "paths": [
    "skills/catalog.json",
    "skills/README.md",
    "skills/deny/DENY.md",
    "skills/packs/*",
    "skills/roles/*/SKILL.md",
    "docs/specs/*",
    "scripts/pack-lint.py",
    "scripts/seat-pack-recipes.py",
    "scripts/pack-census.py",
    "ops/pack-probe.py"
  ],
  "note": "SPEC-V2-2210. Twenty-seven tree rows, one per pack-lint.py class, each run from the skills directory against any --root: it lints every pack in <root>/skills. Sixteen block rows state invariants measured green on the 26 packs at e9fded051; eleven advisory rows report and never refuse.",
  "checks": [
    {
      "id": "body-schema",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "{skills}/../scripts/pack-lint.py",
          "--root",
          "{root}",
          "check",
          "body-schema"
        ],
        "timeout_seconds": 120
      },
      "stage": "body",
      "reason": "body-malformed",
      "scope": "tree"
    },
    {
      "id": "row-fields",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
