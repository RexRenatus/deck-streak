{
  "schema": "phx.lsat.logic.v1",
  "note": "The conditional logic the coach teaches, as data a truth table can check. A translation's form uses {X} and {Y} for a literal (a letter, or 'not' and a letter); its formula is sufficient -> necessary in the notation of the logic block: letters, ~ (not; ! is read too), & (and), | (or), -> and <->. equivalence_groups and converse_pairs are what the sources state, and logic-rules-sound proves every translation agrees with them. An inference's valid flag is proved the same way.",
  "concepts": [
    {"id": "conditional-translation", "label": "turning conditional wording into sufficient -> necessary", "source": "forallx-ch5"},
    {"id": "contrapositive", "label": "if X then Y is equivalent to if not Y then not X", "source": "sep-necessary-sufficient"},
    {"id": "chaining", "label": "joining conditionals whose necessary and sufficient conditions meet", "source": "forallx-ch5"},
    {"id": "mistaken-reversal", "label": "treating the necessary condition as sufficient", "source": "sep-necessary-sufficient"},
    {"id": "mistaken-negation", "label": "negating both conditions without reversing them", "source": "sep-necessary-sufficient"},
    {"id": "necessary-vs-sufficient", "label": "necessary and sufficient conditions are converses", "source": "sep-necessary-sufficient"},
    {"id": "biconditional", "label": "if and only if states both directions", "source": "forallx-ch5"}
  ],
  "translations": [
    {"id": "if-then", "form": "if {X}, {Y}", "formula": "{X} -> {Y}", "concept": "conditional-translation", "source": "forallx-ch5"},
    {"id": "if-then-then", "form": "if {X}, then {Y}", "formula": "{X} -> {Y}", "concept": "conditional-translation", "source": "forallx-ch5"},
    {"id": "only-if", "form": "{X} only if {Y}", "formula": "{X} -> {Y}", "concept": "conditional-translation", "source": "forallx-ch5"},
    {"id": "only-if-front", "form": "only if {Y}, {X}", "formula": "{X} -> {Y}", "concept": "conditional-translation", "source": "forallx-ch5"},
    {"id": "if-after", "form": "{X} if {Y}", "formula": "{Y} -> {X}", "concept": "conditional-translation", "source": "forallx-ch5"},
    {"id": "iff", "form": "{X} if and only if {Y}", "formula": "{X} <-> {Y}", "concept": "biconditional", "source": "forallx-ch5"},
    {"id": "unless", "form": "{X} unless {Y}", "formula": "~{Y} -> {X}", "concept": "conditional-translation", "source": "forallx-ch5"},
    {"id": "unless-front", "form": "unless {Y}, {X}", "formula": "~{Y} -> {X}", "concept": "conditional-translation", "source": "forallx-ch5"},
    {"id": "sufficient", "form": "{X} is sufficient for {Y}", "formula": "{X} -> {Y}", "concept": "necessary-vs-sufficient", "source": "sep-necessary-sufficient"},
    {"id": "necessary", "form": "{X} is necessary for {Y}", "formula": "{Y} -> {X}", "concept": "necessary-vs-sufficient", "source": "sep-necessary-sufficient"},
    {"id": "requires", "form": "{X} requires {Y}", "formula": "{X} -> {Y}", "concept": "conditional-translation", "source": "sep-necessary-sufficient"},
    {"id": "all", "form": "all {X} are {Y}", "formula": "{X} -> {Y}", "concept": "conditional-translation", "source": "forallx-ch5"},
    {"id": "only-are", "form": "only {X} are {Y}", "formula": "{Y} -> {X}", "concept": "conditional-translation", "source": "forallx-ch5"},
    {"id": "no-are", "form": "no {X} are {Y}", "formula": "{X} -> ~{Y}", "concept": "conditional-translation", "source": "forallx-ch5"},
    {"id": "no-without", "form": "no {X} without {Y}", "formula": "{X} -> {Y}", "concept": "conditional-translation", "source": "sep-necessary-sufficient"},
    {"id": "whenever", "form": "whenever {X}, {Y}", "formula": "{X} -> {Y}", "concept": "conditional-translation", "source": "forallx-ch5"}
  ],
  "equivalence_groups": [
    {"id": "x-sufficient-for-y", "members": ["if-then", "if-then-then", "only-if", "only-if-front", "sufficient", "requires", "all", "no-without", "whenever"], "source": "forallx-ch5"},
    {"id": "y-sufficient-for-x", "members": ["if-after", "necessary", "only-are"], "source": "forallx-ch5"},
    {"id": "unless-is-if-not", "members": ["unless", "unless-front"], "source": "forallx-ch5"}
  ],
  "converse_pairs": [
    {"members": ["sufficient", "necessary"], "source": "sep-necessary-sufficient"},
    {"members": ["only-if", "if-after"], "source": "forallx-ch5"},
    {"members": ["all", "only-are"], "source": "forallx-ch5"}
  ],
  "inferences": [
    {"id": "contrapositive", "premises": ["{X} -> {Y}"], "conclusion": "~{Y} -> ~{X}", "valid": true, "concept": "contrapositive", "source": "sep-necessary-sufficient"},
    {"id": "chaining", "premises": ["{X} -> {Y}", "{Y} -> {Z}"], "conclusion": "{X} -> {Z}", "valid": true, "concept": "chaining", "source": "forallx-ch5"},
    {"id": "modus-ponens", "premises": ["{X} -> {Y}", "{X}"], "conclusion": "{Y}", "valid": true, "concept": "conditional-translation", "source": "forallx-ch5"},
    {"id": "modus-tollens", "premises": ["{X} -> {Y}", "~{Y}"], "conclusion": "~{X}", "valid": true, "concept": "contrapositive", "source": "forallx-ch5"},
    {"id": "biconditional-both-ways", "premises": ["{X} <-> {Y}"], "conclusion": "({X} -> {Y}) & ({Y} -> {X})", "valid": true, "concept": "biconditional", "source": "forallx-ch5"},
    {"id": "mistaken-reversal", "premises": ["{X} -> {Y}"], "conclusion": "{Y} -> {X}", "valid": false, "concept": "mistaken-reversal", "source": "sep-necessary-sufficient"},
    {"id": "mistaken-negation", "premises": ["{X} -> {Y}"], "conclusion": "~{X} -> ~{Y}", "valid": false, "concept": "mistaken-negation", "source": "sep-necessary-sufficient"},
    {"id": "affirming-the-consequent", "premises": ["{X} -> {Y}", "{Y}"], "conclusion": "{X}", "valid": false, "concept": "mistaken-reversal", "source": "forallx-ch5"},
    {"id": "denying-the-antecedent", "premises": ["{X} -> {Y}", "~{X}"], "conclusion": "~{Y}", "valid": false, "concept": "mistaken-negation", "source": "forallx-ch5"},
    {"id": "necessary-read-as-sufficient", "premises": ["{Y} -> {X}"], "conclusion": "{X} -> {Y}", "valid": false, "concept": "necessary-vs-sufficient", "source": "sep-necessary-sufficient"}
  ]
}
