{
  "schema": "phx.lsat.format.v1",
  "note": "The current official structure of the LSAT, verified against the test maker's pages and its disclosed forms (SPEC-V2-2215, section 1). This file is the one place these facts live: the template, the examples, the probe and the engine read them here, and every group names the corpus.json source that states it. Analytical Reasoning, the logic games, is no longer part of the test; the Logical Reasoning section covers the deductive reasoning it focused on.",
  "current_sections": ["lr", "rc"],
  "sections": {
    "lr": {
      "name": "Logical Reasoning",
      "questions_per_passage": 1,
      "questions_about": 25,
      "source": "lsac-lr"
    },
    "rc": {
      "name": "Reading Comprehension",
      "sets": 4,
      "questions_per_set": [5, 8],
      "single_passages": [3, 4],
      "comparative_sets": [0, 1],
      "comparative_relations": ["generalization/instance", "principle/application", "point/counterpoint"],
      "source": "lsac-rc"
    }
  },
  "multiple_choice": {
    "sections": 4,
    "section_minutes": 35,
    "scored": {"lr": 2, "rc": 1},
    "unscored": {"count": 1, "one_of": ["lr", "rc"], "position": "any"},
    "intermission": {"minutes": 10, "after_section": 2, "source": "lsac-intermission"},
    "choice_letters": ["A", "B", "C", "D", "E"],
    "answer": "best",
    "source": "lsac-test-format"
  },
  "timed_section": {
    "work_on_other_sections": false,
    "source": "lsac-disclosed-form"
  },
  "retired_sections": [
    {
      "id": "ar",
      "name": "Analytical Reasoning",
      "also_called": ["logic games", "logic game", "games section", "analytical reasoning"],
      "covered_by": "lr",
      "source": "lsac-types"
    }
  ],
  "scoring": {
    "raw": "number correct",
    "deduction_for_incorrect": false,
    "weighting": "equal",
    "scale": [120, 180],
    "conversion": "per form",
    "source": "lsac-scoring"
  },
  "writing": {
    "name": "LSAT Argumentative Writing",
    "scored": false,
    "separate": true,
    "prewriting_minutes": 15,
    "essay_minutes": 35,
    "source": "lsac-test-format"
  },
  "accommodations": {
    "time_multiplier_min": 1,
    "minutes_rounding": "up",
    "source": "lsac-accommodations"
  }
}
