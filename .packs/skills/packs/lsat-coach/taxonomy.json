{
  "schema": "phx.lsat.taxonomy.v1",
  "note": "The test maker names SKILLS, not question types: ten for Logical Reasoning and ten question areas for Reading Comprehension, quoted verbatim in skills[*].lsac. The type names below are the prep convention, which publishers name differently, so every type maps to exactly one of those skills and a drill grade recorded by type always rolls up to an official skill. cues are stem phrases, matched on word boundaries, that stem-cue reads as advice. formal_logic names the Logical Reasoning types where the conditional and formal reasoning lives: the owner's 'logic'. traps is the closed vocabulary an explanation names a wrong choice by.",
  "sources": {"lr": "lsac-lr", "rc": "lsac-rc"},
  "skills": {
    "lr": [
      {"id": "argument-parts", "lsac": "Recognizing the parts of an argument and their relationships"},
      {"id": "reasoning-patterns", "lsac": "Recognizing similarities and differences between patterns of reasoning"},
      {"id": "well-supported-conclusions", "lsac": "Drawing well-supported conclusions"},
      {"id": "analogy", "lsac": "Reasoning by analogy"},
      {"id": "disagreement", "lsac": "Recognizing misunderstandings or points of disagreement"},
      {"id": "additional-evidence", "lsac": "Determining how additional evidence affects an argument"},
      {"id": "assumptions", "lsac": "Detecting assumptions made by particular arguments"},
      {"id": "principles", "lsac": "Identifying and applying principles or rules"},
      {"id": "flaws", "lsac": "Identifying flaws in arguments"},
      {"id": "explanations", "lsac": "Identifying explanations"}
    ],
    "rc": [
      {"id": "main-idea", "lsac": "The main idea or primary purpose"},
      {"id": "explicit", "lsac": "Information that is explicitly stated"},
      {"id": "inferred", "lsac": "Information or ideas that can be inferred"},
      {"id": "meaning-in-context", "lsac": "The meaning or purpose of words or phrases as used in context"},
      {"id": "structure", "lsac": "The organization or structure"},
      {"id": "new-context", "lsac": "The application of information in the selection to a new context"},
      {"id": "principles-in-selection", "lsac": "Principles that function in the selection"},
      {"id": "analogies", "lsac": "Analogies to claims or arguments in the selection"},
      {"id": "attitude", "lsac": "An author's attitude as revealed in the tone of a passage or the language used"},
      {"id": "new-information", "lsac": "The impact of new information on claims or arguments in the selection"},
      {"id": "passage-relationship", "lsac": "how the two passages of a comparative reading set relate", "listed": false}
    ]
  },
  "types": [
    {"id": "main-conclusion", "section": "lr", "skill": "argument-parts", "cues": ["main conclusion", "overall conclusion", "main point", "conclusion drawn in the argument"]},
    {"id": "role", "section": "lr", "skill": "argument-parts", "cues": ["role played", "figures in the argument", "plays which one of the following roles", "serves which one of the following"]},
    {"id": "method", "section": "lr", "skill": "argument-parts", "cues": ["proceeds by", "argumentative technique", "argumentative strategy", "method of reasoning", "does which one of the following", "responds to"]},
    {"id": "parallel-reasoning", "section": "lr", "skill": "reasoning-patterns", "cues": ["most similar in its reasoning", "reasoning most similar", "pattern of reasoning most similar", "most closely parallels"]},
    {"id": "parallel-flaw", "section": "lr", "skill": "reasoning-patterns", "cues": ["flawed reasoning most similar", "pattern of flawed reasoning", "questionable reasoning most similar"]},
    {"id": "inference", "section": "lr", "skill": "well-supported-conclusions", "cues": ["properly inferred", "must be true", "must also be true", "logically follows", "properly concluded"]},
    {"id": "most-strongly-supported", "section": "lr", "skill": "well-supported-conclusions", "cues": ["most strongly supported", "provide the most support for", "most strongly support which"]},
    {"id": "principle-parallel", "section": "lr", "skill": "analogy", "cues": ["principle illustrated", "illustrates the same principle", "illustrates a principle most similar"]},
    {"id": "point-at-issue", "section": "lr", "skill": "disagreement", "cues": ["disagree", "disagreement", "point at issue", "at issue between"]},
    {"id": "point-of-agreement", "section": "lr", "skill": "disagreement", "cues": ["agree that", "agree about", "both committed to"]},
    {"id": "strengthen", "section": "lr", "skill": "additional-evidence", "cues": ["most strengthens", "strengthens the argument", "most strongly supports the argument", "most helps to support"]},
    {"id": "weaken", "section": "lr", "skill": "additional-evidence", "cues": ["most weakens", "most seriously weakens", "most seriously undermines", "calls into question", "casts the most doubt"]},
    {"id": "evaluate", "section": "lr", "skill": "additional-evidence", "cues": ["most useful to know", "most helpful to know", "most useful in evaluating", "to evaluate the argument"]},
    {"id": "necessary-assumption", "section": "lr", "skill": "assumptions", "cues": ["assumption required by", "assumption on which", "an assumption the argument requires", "depends on assuming", "relies on the assumption", "requires assuming", "argument assumes"]},
    {"id": "sufficient-assumption", "section": "lr", "skill": "assumptions", "cues": ["follows logically if", "properly drawn if", "properly inferred if", "enables the conclusion to be properly drawn"]},
    {"id": "principle-justify", "section": "lr", "skill": "principles", "cues": ["most helps to justify", "principle, if valid", "principles, if valid"]},
    {"id": "principle-apply", "section": "lr", "skill": "principles", "cues": ["conforms most closely to the principle", "most closely conforms to the principle", "in accordance with the principle"]},
    {"id": "flaw", "section": "lr", "skill": "flaws", "cues": ["flawed because", "vulnerable to criticism", "vulnerable to the criticism", "reasoning error", "flaw in the reasoning", "questionable because"]},
    {"id": "resolve", "section": "lr", "skill": "explanations", "cues": ["resolve the apparent discrepancy", "resolve the apparent conflict", "explain the apparent", "most helps to explain", "reconcile"]},
    {"id": "rc-main-point", "section": "rc", "skill": "main-idea", "cues": ["main point", "main idea", "primary purpose", "central idea"]},
    {"id": "rc-detail", "section": "rc", "skill": "explicit", "cues": ["according to the passage", "the passage states", "the author mentions", "the passage explicitly"]},
    {"id": "rc-inference", "section": "rc", "skill": "inferred", "cues": ["can be inferred", "most likely agree", "most strongly supported by the passage", "the passage suggests"]},
    {"id": "rc-meaning-in-context", "section": "rc", "skill": "meaning-in-context", "cues": ["most nearly means", "is used to refer to", "most likely means", "primarily in order to", "serves primarily to"]},
    {"id": "rc-structure", "section": "rc", "skill": "structure", "cues": ["organization of the passage", "structure of the passage", "is organized", "function of the"]},
    {"id": "rc-application", "section": "rc", "skill": "new-context", "cues": ["most likely to regard", "which one of the following situations", "would most likely apply", "most likely to endorse"]},
    {"id": "rc-principle", "section": "rc", "skill": "principles-in-selection", "cues": ["principle underlies", "principle that underlies", "most closely exemplifies the principle"]},
    {"id": "rc-analogy", "section": "rc", "skill": "analogies", "cues": ["most analogous", "analogous to"]},
    {"id": "rc-attitude", "section": "rc", "skill": "attitude", "cues": ["attitude", "tone", "regard with"]},
    {"id": "rc-new-information", "section": "rc", "skill": "new-information", "cues": ["if true, would most strengthen", "if true, would most weaken", "would most undermine", "would most support the"]},
    {"id": "rc-comparative", "section": "rc", "skill": "passage-relationship", "cues": ["both passages", "passage a", "passage b", "the two passages"]}
  ],
  "formal_logic": {
    "note": "The Logical Reasoning section covers the deductive reasoning the logic games focused on. These are the types where it is tested, and the logic.json concepts that teach it.",
    "types": ["inference", "necessary-assumption", "sufficient-assumption", "flaw", "parallel-reasoning", "parallel-flaw", "principle-apply"],
    "concepts": ["conditional-translation", "contrapositive", "chaining", "mistaken-reversal", "mistaken-negation", "necessary-vs-sufficient", "biconditional"]
  },
  "traps": [
    {"id": "true-but-unresponsive", "means": "a true statement that does not answer the question asked", "source": "lsac-lr-approach"},
    {"id": "outside-knowledge", "means": "an answer that needs knowledge the passage does not give", "source": "lsac-lr-approach"},
    {"id": "unsupported", "means": "says what the passage does not say", "source": "lsac-rc"},
    {"id": "out-of-scope", "means": "about something the argument or passage does not address"},
    {"id": "too-strong", "means": "claims more than the passage or argument supports"},
    {"id": "too-weak", "means": "does less than the question requires"},
    {"id": "half-right", "means": "right in one part and wrong in another"},
    {"id": "opposite", "means": "does the reverse of what the question asks"},
    {"id": "reversal", "means": "reverses a conditional: treats the necessary condition as sufficient"},
    {"id": "negation", "means": "negates both sides of a conditional without reversing them"},
    {"id": "necessary-vs-sufficient", "means": "confuses a necessary condition with a sufficient one"},
    {"id": "correlation-causation", "means": "reads cause from correlation, or ignores an alternative cause"},
    {"id": "irrelevant-comparison", "means": "compares things the argument never compares"},
    {"id": "wrong-part", "means": "describes the wrong part of the argument or passage"}
  ]
}
