{
  "schema": "phx.skills.checks.v1",
  "pack": "packs/sdd",
  "spec": "SPEC-V2-2186",
  "paths": [
    "docs/specs/*",
    "docs/decisions/*",
    "docs/schematics/*",
    "methodology.json",
    "scripts/sdd-probe.py",
    "scripts/methodology_probe.py"
  ],
  "checks": [
    {
      "id": "spec-sections",
      "severity": "block",
      "probe": {
        "command": [
          "python3",
          "scripts/sdd-probe.py",
          "--root",
          "{root}",
          "check",
          "spec-sections"
        ],
        "timeout_seconds": 120
      },
      "stage": "sdd",
      "reason": "spec-sections_red",
      "scope": "tree"
    },
    {
      "id": "exclusions-cited",
