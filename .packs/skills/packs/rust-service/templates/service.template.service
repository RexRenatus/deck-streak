# The unit for service-main.rs.template (skills/packs/rust-service). It carries what the
# rust-service rows read: Type=notify with WatchdogSec= (READY=1 and WATCHDOG=1 are sent), the
# credential the binary reads from $CREDENTIALS_DIRECTORY, and a stop the binary drains within.
# Hardening, restart policy and resource ceilings are the durable-services pack's rows; the
# alert path is the observability pack's.
[Unit]
Description=DeckStreak API
Wants=network-online.target
After=network-online.target
OnFailure=deckstreak-alert@%n.service

[Service]
Type=notify
ExecStart=/opt/deckstreak/bin/deckstreak-server
WatchdogSec=30s
Restart=on-failure
RestartSec=2s
# SIGTERM (systemd's default KillSignal=) starts the drain; SIGKILL follows after this.
TimeoutStopSec=20s
Environment=RUST_LOG=info
Environment=DECKSTREAK_LISTEN=127.0.0.1:8080
LoadCredential=telegram-bot-token:/etc/credstore/telegram-bot-token
MemoryHigh=300M
MemoryMax=400M

[Install]
WantedBy=multi-user.target
