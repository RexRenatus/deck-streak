// A service binary on the rust-service pack's rules (skills/packs/rust-service/SKILL.md).
// Copy it to `crates/<service>/src/main.rs` beside the observability pack's
// `templates/logging.rs.template`, copied as `logging.rs`, and rename what is DeckStreak's.
//
// What it shows: lints come from the workspace table; errors are typed where a library would
// return them, and `anyhow` is used only in `main`; the secret comes from $CREDENTIALS_DIRECTORY;
// the router has a timeout, a concurrency bound and a panic catcher, all INSIDE the trace layer so
// a 408 or a caught panic is still a logged request; readiness and the watchdog go to systemd; and
// a SIGTERM drains in-flight requests before the process exits.

mod logging;

use std::os::unix::net::UnixDatagram;
use std::path::PathBuf;
use std::time::Duration;

use axum::http::header::{AUTHORIZATION, COOKIE};
use axum::http::{HeaderName, StatusCode};
use axum::routing::get;
use axum::Router;
use tower::limit::GlobalConcurrencyLimitLayer;
use tower_http::catch_panic::CatchPanicLayer;
use tower_http::request_id::{MakeRequestUuid, PropagateRequestIdLayer, SetRequestIdLayer};
use tower_http::sensitive_headers::SetSensitiveRequestHeadersLayer;
use tower_http::timeout::TimeoutLayer;
use tower_http::trace::{DefaultOnResponse, TraceLayer};
use tracing::Level;

/// Requests served at once. Each holds its buffers until it answers, so this bounds memory.
const MAX_IN_FLIGHT: usize = 64;
/// A request that has not answered by now is cut off with 408.
const REQUEST_TIMEOUT: Duration = Duration::from_secs(10);
/// Telegram's webhook secret travels in this header; it is never logged.
const WEBHOOK_SECRET_HEADER: &str = "x-telegram-bot-api-secret-token";

/// Why start-up failed. A library crate returns a type like this; `main` alone uses anyhow.
#[derive(Debug, thiserror::Error)]
enum ConfigError {
    #[error("credential {0} was not loaded: add LoadCredential= to the unit")]
    MissingCredential(&'static str),
    #[error("cannot read credential {name}")]
    Unreadable {
        name: &'static str,
        #[source]
        source: std::io::Error,
    },
}

/// Configuration that is not secret comes from the environment; a secret never does.
struct Config {
    listen: String,
    bot_token: String,
}

impl Config {
    fn load() -> Result<Self, ConfigError> {
        Ok(Self {
            listen: std::env::var("DECKSTREAK_LISTEN")
                .unwrap_or_else(|_| "127.0.0.1:8080".to_owned()),
            bot_token: credential("telegram-bot-token")?,
        })
    }
}

/// Read one credential systemd's LoadCredential= placed in $CREDENTIALS_DIRECTORY.
fn credential(name: &'static str) -> Result<String, ConfigError> {
    let dir = std::env::var_os("CREDENTIALS_DIRECTORY")
        .ok_or(ConfigError::MissingCredential(name))?;
    std::fs::read_to_string(PathBuf::from(dir).join(name))
        .map(|text| text.trim().to_owned())
        .map_err(|source| ConfigError::Unreadable { name, source })
}

/// Send one sd_notify(3) state ("READY=1", "WATCHDOG=1", "STOPPING=1") to systemd. Outside
/// systemd there is no $NOTIFY_SOCKET and this does nothing. No crate is needed for it.
fn notify(state: &str) {
    let Some(path) = std::env::var_os("NOTIFY_SOCKET") else {
        return;
    };
    let Ok(socket) = UnixDatagram::unbound() else {
        return;
    };
    let path = path.to_string_lossy().into_owned();
    let sent = if let Some(name) = path.strip_prefix('@') {
        use std::os::linux::net::SocketAddrExt;
        std::os::unix::net::SocketAddr::from_abstract_name(name)
            .and_then(|address| socket.send_to_addr(state.as_bytes(), &address))
            .map(|_| ())
    } else {
        socket.send_to(state.as_bytes(), &path).map(|_| ())
    };
    if let Err(error) = sent {
        tracing::warn!(%error, state, "sd_notify failed");
    }
}

/// Ping the watchdog at half of WatchdogSec=, as sd_watchdog_enabled(3) advises.
fn spawn_watchdog() {
    let Some(usec) = std::env::var("WATCHDOG_USEC")
        .ok()
        .and_then(|value| value.parse::<u64>().ok())
    else {
        return;
    };
    let period = Duration::from_micros(usec / 2);
    tokio::spawn(async move {
        loop {
            notify("WATCHDOG=1");
            tokio::time::sleep(period).await;
        }
    });
}

/// Resolve on SIGTERM, which systemd stops a unit with, or on Ctrl-C at a terminal.
async fn shutdown_signal() {
    let ctrl_c = async {
        let _ = tokio::signal::ctrl_c().await;
    };
    let terminate = async {
        if let Ok(mut signal) =
            tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
        {
            signal.recv().await;
        }
    };
    tokio::select! {
        () = ctrl_c => {},
        () = terminate => {},
    }
    notify("STOPPING=1");
}

async fn health() -> &'static str {
    "ok"
}

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    logging::init();
    let config = Config::load()?;
    // The first layer added is the innermost. Outward from the handler: the request id is
    // copied to the response, the concurrency bound, the timeout, the panic catcher, the trace,
    // the sensitive headers, then the request id is set, so the trace sees every one of them.
    let app = Router::new()
        .route("/api/health", get(health))
        .layer(PropagateRequestIdLayer::x_request_id())
        .layer(GlobalConcurrencyLimitLayer::new(MAX_IN_FLIGHT))
        .layer(TimeoutLayer::with_status_code(
            StatusCode::REQUEST_TIMEOUT,
            REQUEST_TIMEOUT,
        ))
        .layer(CatchPanicLayer::new())
        .layer(
            TraceLayer::new_for_http()
                .make_span_with(logging::request_span)
                .on_response(DefaultOnResponse::new().level(Level::INFO)),
        )
        .layer(SetSensitiveRequestHeadersLayer::new([
            AUTHORIZATION,
            COOKIE,
            HeaderName::from_static(WEBHOOK_SECRET_HEADER),
        ]))
        .layer(SetRequestIdLayer::x_request_id(MakeRequestUuid));
    let listener = tokio::net::TcpListener::bind(&config.listen).await?;
    notify("READY=1");
    spawn_watchdog();
    tracing::info!(listen = %config.listen, "serving");
    axum::serve(listener, app)
        .with_graceful_shutdown(shutdown_signal())
        .await?;
    drop(config.bot_token);
    Ok(())
}
