// A planted tool module that lets write tools through on the read grant (SPEC-369 A6). It is
// never compiled: A6's census must refuse exactly `planted_erase`, a tool annotated
// `read_only_hint = false` that authorizes `Scope::Core`, and `planted_unmarked`, a tool with no
// annotation (MCP reads it as not read-only) that authorizes `Scope::Core`, and pass the other two.
//
// A comment that says #[tool(annotations(read_only_hint = false))] fn commented_out() is prose,
// and so is the string below.

const NOTE: &str = "#[tool(annotations(read_only_hint = false))] fn quoted_out() { authorize(granted, Scope::Core) }";

#[tool_router]
impl PlantedServer {
    /// A write tool that asks the guard for the read grant's scope: the census refuses it.
    #[tool(
        name = "planted_erase",
        description = "Erases every card (a plant; never served).",
        annotations(read_only_hint = false, destructive_hint = true)
    )]
    async fn planted_erase(&self, mut extensions: Extensions) -> Result<String, CallToolResult> {
        let granted = granted(&mut extensions)?;
        if self.guard.authorize(granted, Scope::Core).is_err() {
            return Err(denied());
        }
        Ok(String::new())
    }

    /// A read tool on the read grant's scope: the census passes it.
    #[tool(name = "planted_read", annotations(read_only_hint = true))]
    async fn planted_read(&self, mut extensions: Extensions) -> Result<String, CallToolResult> {
        let granted = granted(&mut extensions)?;
        if self.guard.authorize(granted, Scope::Core).is_err() {
            return Err(denied());
        }
        Ok(String::new())
    }

    /// A write tool that asks the guard for `write` before it touches anything: the census
    /// passes it.
    #[tool(name = "planted_write", annotations(read_only_hint = false))]
    async fn planted_write(&self, mut extensions: Extensions) -> Result<String, CallToolResult> {
        let granted = granted(&mut extensions)?;
        if self.guard.authorize(granted, Scope::Write).is_err() {
            return Err(denied());
        }
        Ok(String::new())
    }

    /// A tool with no annotation, which MCP reads as not read-only, that asks the guard for the
    /// read grant's scope: the census refuses it.
    #[tool(name = "planted_unmarked")]
    async fn planted_unmarked(&self, mut extensions: Extensions) -> Result<String, CallToolResult> {
        let granted = granted(&mut extensions)?;
        if self.guard.authorize(granted, Scope::Core).is_err() {
            return Err(denied());
        }
        Ok(String::new())
    }
}
