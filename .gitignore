# Rust build output (github/gitignore Rust.gitignore)
/target/
**/*.rs.bk
rustc-ice-*.txt

# Node and SvelteKit (github/gitignore Node.gitignore)
node_modules/
.svelte-kit/
build/
.vite/

# Environment files hold real values and are never committed. `.env.example` names each
# variable without a value, and is the one environment file that is.
.env
.env.*
!.env.example

# Editors and operating systems
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Python caches and the gate's stage logs
__pycache__/
*.pyc
.check-logs/

# Playwright output
test-results/
playwright-report/

# Mutation testing's output (SPEC-039): cargo-mutants' reports, StrykerJS's sandboxes and reports
mutants.out/
mutants.out.old/
.stryker-tmp/
web/app/reports/

# The Swift harness (SPEC-339): the generated project, what CI places from the run's own artifact,
# test results, and a person's own signing settings.
ios/*.xcodeproj/
ios/EnginePackage/DeckStreakFFI.xcframework/
ios/EnginePackage/Sources/DeckStreakFFI/
ios/Harness/Resources/collection.anki2
ios/Harness/Resources/collection.media/
*.xcresult
DerivedData/
.build/
.swiftpm/
ios/Config/Signing.local.xcconfig
