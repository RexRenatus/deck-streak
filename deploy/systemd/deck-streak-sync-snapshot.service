# The sync server's stopped-server window: the snapshot's copy, run inside the daily backup's run
# (SPEC-337 R5; ADR-347 D12). The server holds each user's media index in SQLite's exclusive locking
# mode for its whole life, so the copy runs with the server stopped, and only the copy does: every
# check, the archive and the offsite copy run in deck-streak-sync-archive.service after it
# (SPEC-340 R3; ADR-351 D1).
#
# Starting this unit stops the server first (Conflicts=, with the stop ordered before this start),
# and PID 1 starts the server again when it ends, on success and on failure alike (OnSuccess=,
# OnFailure=), so it needs no grant. It carries no Condition, Assert or ExecCondition: a condition is
# checked after the stop, and a skipped start fires neither, which would leave the server stopped.
# It is gated by being enabled instead: deck-streak-sync-server.service's Also= enables it, which
# links it into the backup's run, and disabling the server unlinks it. A template with neutral values
# that the private rail fills (deploy/README.md).
[Unit]
Description=DeckStreak sync server snapshot window (the copy, with the server stopped)
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/docs/runbooks/sync-server-cutover.md
Conflicts=deck-streak-sync-server.service
After=deck-streak-sync-server.service
Before=deck-streak-backup.service
OnSuccess=deck-streak-sync-server.service
OnFailure=deck-streak-sync-server.service
OnFailure=deck-streak-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/deck-streak/current/deploy/scripts/backup.py --sync-window
# The sync family's own user and group (SPEC-340 R2; ADR-351 D1).
User=deck-streak-sync
Group=deck-streak-sync
# The sync family's snapshots directory it writes, first, and the server's store it reads.
StateDirectory=deck-streak-sync-snapshots deck-streak-sync-server
# The window is bounded: a hung copy is stopped, which fails the unit and starts the server again.
TimeoutStartSec=15min
SyslogIdentifier=deck-streak-sync-snapshot
# The budget is deploy/host-budget.json's entry for this unit (ADR-032, ADR-347).
MemoryHigh=48M
MemoryMax=64M
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# It reads and writes files and opens no network socket.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=deck-streak-backup.service
