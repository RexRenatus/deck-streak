# The sync server's snapshot drill (SPEC-340 R4; ADR-351 D1): it restores the newest snapshot
# archive into a private temporary directory, checks every file against the archive's manifest of
# sha256 digests, runs `PRAGMA integrity_check` on each user's collection and media index, and
# opens each collection to count its cards. A missing snapshot directory, or one with no archive,
# fails it. It restores nothing into the server's store.
#
# It runs as the sync family's own user, so no directory is shared with DeckStreak's user. The
# restore drill's run pulls it in and it runs after that drill, so the two never overlap; it is
# gated by being enabled: deck-streak-sync-server.service's Also= enables it, and disabling the
# server removes it. It exits 1 on any failed step, so OnFailure= pages through the one alert path.
# A template with neutral values that the private rail fills (deploy/README.md).
[Unit]
Description=DeckStreak sync server snapshot restore drill
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/docs/runbooks/sync-server-cutover.md
After=deck-streak-restore-drill.service
OnFailure=deck-streak-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/deck-streak/current/deploy/scripts/restore-drill.sh --part sync
# The sync family's own user and group (SPEC-340 R2; ADR-351 D1).
User=deck-streak-sync
Group=deck-streak-sync
# The sync family's snapshots directory it reads the newest archive from.
StateDirectory=deck-streak-sync-snapshots
# It yields the processor and the disk to the long-running services.
Nice=10
IOSchedulingClass=idle
# A restore that hangs ends long before the next drill is due.
TimeoutStartSec=1h
SyslogIdentifier=deck-streak-sync-restore-drill
# The budget is deploy/host-budget.json's entry for this unit (ADR-032, ADR-351).
MemoryHigh=96M
MemoryMax=128M
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# It reads and writes files and opens no network socket.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=deck-streak-restore-drill.service
