# DeckStreak's weekly restore drill: the replica restored to a private path, the newest daily copy
# opened, both checked and compared with the live database, then both removed (SPEC-064 R5; ADR-010,
# ADR-064). deck-streak-restore-drill.timer starts it once a week; it exits 1 on any failed step, so
# OnFailure= pages through the one alert path with its error lines. It restores nothing into the live
# database. A template with neutral values that the private rail fills (deploy/README.md).
[Unit]
Description=DeckStreak weekly restore drill of the replica and the daily copy
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/deploy/README.md
OnFailure=deck-streak-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/deck-streak/current/deploy/scripts/restore-drill.sh
User=deck-streak
Group=deck-streak
# The live database it compares with and the backups directory it reads.
StateDirectory=deck-streak
# The configuration expands the bucket from this file when Litestream restores.
EnvironmentFile=/etc/deck-streak/deck-streak.env
# It yields the processor and the disk to the long-running services.
Nice=10
IOSchedulingClass=idle
# A restore that hangs ends before the week is out.
TimeoutStartSec=1h
SyslogIdentifier=deck-streak-restore-drill
# The budget is deploy/host-budget.json's entry for this unit (ADR-032, ADR-064).
MemoryHigh=96M
MemoryMax=128M
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# It reaches the bucket over the network and its own files over a socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
