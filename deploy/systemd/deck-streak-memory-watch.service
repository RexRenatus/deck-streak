# DeckStreak's memory watch: each DeckStreak unit's memory events against its MemoryHigh and
# MemoryMax, paged once per event (SPEC-031 R5, R6; ADR-031, ADR-032). deck-streak-memory-watch.timer
# starts it every minute; it exits 1 on a new OOM kill or MemoryMax event, so OnFailure= pages
# through the one alert path with its error lines. A template with neutral values that the private
# rail fills (deploy/README.md).
[Unit]
Description=DeckStreak memory watch, each unit's memory events against its ceilings
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/deploy/README.md
OnFailure=deck-streak-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/deck-streak/current/deploy/scripts/memory-watch.sh
User=deck-streak
Group=deck-streak
# Each unit's counters at its last run, which make a page once per event; its own directory, so it
# can write nothing of the API's.
StateDirectory=deck-streak-memory-watch
# It yields the processor and the disk to the long-running services.
Nice=10
IOSchedulingClass=idle
# A hung run ends before the timer is due again.
TimeoutStartSec=50s
SyslogIdentifier=deck-streak-memory-watch
# The budget is deploy/host-budget.json's entry for this unit (ADR-032).
MemoryHigh=32M
MemoryMax=48M
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# It reads files and opens no network socket.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
