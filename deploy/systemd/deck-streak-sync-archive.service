# The sync server's snapshot archive (SPEC-340 R3; ADR-351 D1, D2): after the stopped-server window,
# deck-streak-sync-snapshot.service, it checks the newest generation's databases with
# `PRAGMA integrity_check`, writes a manifest of sha256 digests, renames the generation into an
# archive, seals the archive and its manifest to the owner's offline key, copies only the sealed
# files offsite by the command and bucket the settings name (with arguments, no shell), and keeps
# the newest three archives on the host for the drill.
#
# It runs as the sync family's own user, so no directory is shared with DeckStreak's user. The
# daily backup's run pulls it in, after the window and before the database's copy; it is gated by
# being enabled, as the window is: deck-streak-sync-server.service's Also= enables it, and disabling
# the server removes it. It exits 1 on any failed step, so OnFailure= pages through the one alert
# path. A template with neutral values that the private rail fills (deploy/README.md).
[Unit]
Description=DeckStreak sync server snapshot archive (check, archive, seal, copy offsite)
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/docs/runbooks/sync-server-cutover.md
After=deck-streak-sync-snapshot.service
Before=deck-streak-backup.service
OnFailure=deck-streak-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/deck-streak/current/deploy/scripts/backup.py --sync-archive
# The sync family's own user and group (SPEC-340 R2; ADR-351 D1).
User=deck-streak-sync
Group=deck-streak-sync
# The sync family's snapshots directory, which holds the window's generation and the archives.
StateDirectory=deck-streak-sync-snapshots
# The offsite copy's command and bucket, and the seal's command (deploy/deck-streak.env.example).
EnvironmentFile=/etc/deck-streak/deck-streak.env
# It yields the processor and the disk to the long-running services.
Nice=10
IOSchedulingClass=idle
# A hung run ends long before the next is due.
TimeoutStartSec=30min
SyslogIdentifier=deck-streak-sync-archive
# The budget is deploy/host-budget.json's entry for this unit (ADR-032, ADR-351).
MemoryHigh=48M
MemoryMax=64M
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# It reads and writes files, and the sealed copy reaches the bucket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=deck-streak-backup.service
