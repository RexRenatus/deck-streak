# DeckStreak's one alert path: page the owner on Telegram that the unit %i failed, naming it, its
# result and its last error lines (SPEC-031 R3, R6; ADR-031, ADR-038). Every service and scheduled job
# names it with OnFailure=deck-streak-alert@%n.service, and the SLO evaluator and the memory watch page
# through it by failing. A template with neutral values that the private rail fills
# (deploy/README.md); nothing in it is one host's value.
[Unit]
Description=DeckStreak alert, a page to the owner that %i failed
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/deploy/README.md
# No OnFailure= here: a page that fails must not start a page about the page. It stays failed, in
# systemctl --failed and in the journal.
# The page reaches Telegram's Bot API.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/deck-streak/current/deploy/scripts/alert-telegram.sh %i
User=deck-streak
Group=deck-streak
# To quote the failed run's error lines from the journal.
SupplementaryGroups=systemd-journal
# The bot token, and the owner's user id, whose private chat the page goes to, each read from the
# private rail's socket at every start and never stored (ADR-038). It reads no settings file and
# writes nothing, so a page waits on neither.
LoadCredential=owner-user-id:/run/deck-streak-credentials/socket
LoadCredential=telegram-bot-token:/run/deck-streak-credentials/socket
# curl's three retries fit inside it.
TimeoutStartSec=3min
SyslogIdentifier=%N
# The budget is deploy/host-budget.json's entry for this template (ADR-032).
MemoryHigh=32M
MemoryMax=48M
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX, which a name lookup may use, and AF_INET and AF_INET6 for the request.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
