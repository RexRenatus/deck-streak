# The ONE alert path: every service and scheduled job names it with OnFailure=alert@%n.service,
# and the SLO evaluator and the memory watch page through it by failing. Copy it to
# deploy/<product>-alert@.service. %i is the unit that failed.
[Unit]
Description=Page the owner on Telegram that %i failed

[Service]
Type=oneshot
ExecStart=/opt/deckstreak/deploy/alert-telegram.sh %i
# The bot token and the owner's chat id are credentials, never committed and never in the
# environment (systemd.exec(5): environment variables are not suitable for passing secrets).
LoadCredential=telegram-bot-token:/etc/credstore/telegram-bot-token
LoadCredential=telegram-alert-chat:/etc/credstore/telegram-alert-chat
# Read the failed unit's journal lines, to quote them.
SupplementaryGroups=systemd-journal
