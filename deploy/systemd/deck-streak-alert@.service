# DeckStreak's one alert path: write one line at error priority to the journal saying that
# the unit %i failed, naming it and its result and quoting no line of its run (SPEC-031 R3, R6, as
# SPEC-582 R7 amends them; ADR-031, ADR-601 D4, D9). Every service and scheduled job
# names it with OnFailure=deck-streak-alert@%n.service, and the SLO evaluator and the memory watch page
# through it by failing. A template with neutral values that the private rail fills
# (deploy/README.md); nothing in it is one host's value.
[Unit]
Description=DeckStreak alert, a page to the owner that %i failed
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/deploy/README.md
# No OnFailure= here: a page that fails must not start a page about the page. It stays failed, in
# systemctl --failed and in the journal.
# The sender makes no request; the network lines stay for the monitoring delivery (ADR-601 D2).
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/deck-streak/current/deploy/scripts/alert-journal.sh %i
User=deck-streak
Group=deck-streak
# Kept with the sandbox lines (SPEC-582 R7); the sender reads no journal.
SupplementaryGroups=systemd-journal
# It loads no credential: the sender reads none (SPEC-582 R7). It reads no settings file and
# writes nothing but its one journal line, so a page waits on neither.
# One written line fits well inside it.
TimeoutStartSec=3min
SyslogIdentifier=%N
# The budget is deploy/host-budget.json's entry for this template (ADR-032).
MemoryHigh=32M
MemoryMax=48M
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX, which a name lookup may use, and AF_INET and AF_INET6 for the request.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# It never uses the host's identity, so the kernel refuses it every route to the host's identity
# endpoint (SPEC-354 R1; ADR-365 D1).
IPAddressDeny=link-local
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
