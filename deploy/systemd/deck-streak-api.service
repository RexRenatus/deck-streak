# DeckStreak's API: the HTTP service the Mini App calls through the Caddy block's /api/* proxy
# (SPEC-025, SPEC-032; ADR-007, ADR-010, ADR-025). A template with neutral values that the private
# rail fills (deploy/README.md); nothing in it is one host's value.
[Unit]
Description=DeckStreak API, the HTTP service the Mini App calls
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/deploy/README.md
# A failed unit pages through the one alert path (the alert template is SPEC-031's).
OnFailure=deck-streak-alert@%n.service
# Five starts at RestartSec=15 take 75 seconds, inside 300, so a crash loop reaches failed and pages.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# READY=1 once the loopback listener is bound, then WATCHDOG=1 every third of WatchdogSec (SPEC-025).
Type=notify
ExecStart=/usr/local/lib/deck-streak/current/bin/deckstreakd api
User=deck-streak
Group=deck-streak
StateDirectory=deck-streak
EnvironmentFile=/etc/deck-streak/deck-streak.env
# Each credential is read from the private rail's socket at every start and never stored (ADR-038).
LoadCredential=owner-user-id:/run/deck-streak-credentials/socket
LoadCredential=telegram-bot-token:/run/deck-streak-credentials/socket
Restart=on-failure
RestartSec=15
WatchdogSec=90
TimeoutStartSec=180
TimeoutStopSec=30
OOMPolicy=kill
SyslogIdentifier=deck-streak-api
# The budget is deploy/host-budget.json's entry for this unit (ADR-032); its CPU quota gave the MCP
# server its share and is a ceiling, not a reservation (ADR-332).
MemoryHigh=96M
MemoryMax=128M
CPUQuota=75%
TasksMax=64
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX carries the sd_notify datagram, and AF_INET and AF_INET6 the loopback listener.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Its only peers are on loopback: the edge that proxies to its listener, and the deploy's readiness
# check. Every other address is denied, the host's identity endpoint among them (SPEC-395 R1;
# ADR-409 D2; SPEC-354 R1; ADR-365 D1).
IPAddressAllow=localhost
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
