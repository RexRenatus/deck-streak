# DeckStreak's SLO evaluator: the API's burn rates against deploy/slo.json, paged once per burn
# episode (SPEC-031 R4, R6; ADR-031). deck-streak-slo.timer starts it every five minutes; it exits 1
# when an alert starts to burn, so OnFailure= pages through the one alert path with its error lines.
# A template with neutral values that the private rail fills (deploy/README.md).
[Unit]
Description=DeckStreak SLO evaluator, the API's burn rates against its SLO
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/deploy/README.md
OnFailure=deck-streak-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/deck-streak/current/deploy/scripts/slo-evaluate.py /usr/local/lib/deck-streak/current/deploy/slo.json
User=deck-streak
Group=deck-streak
# To read the API's response events from the journal.
SupplementaryGroups=systemd-journal
# The alerts burning at its last run, which make a page once per episode; its own directory, so it
# can write nothing of the API's.
StateDirectory=deck-streak-slo
# It yields the processor and the disk to the long-running services.
Nice=10
IOSchedulingClass=idle
# A hung run ends before the timer is due again.
TimeoutStartSec=4min
SyslogIdentifier=deck-streak-slo
# The budget is deploy/host-budget.json's entry for this unit (ADR-032).
MemoryHigh=48M
MemoryMax=64M
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# It reads files and pipes and opens no network socket.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
