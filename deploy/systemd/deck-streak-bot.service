# DeckStreak's bot: the Telegram bot's long-polling transport, owner-gated (SPEC-026, SPEC-032;
# ADR-010, ADR-026). A template with neutral values that the private rail fills (deploy/README.md);
# nothing in it is one host's value.
[Unit]
Description=DeckStreak bot, the Telegram bot's long-polling transport
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/deploy/README.md
# A failed unit pages through the one alert path (the alert template is SPEC-031's).
OnFailure=deck-streak-alert@%n.service
# The poll reaches Telegram's Bot API.
Wants=network-online.target
After=network-online.target
# Five starts at RestartSec=15 take 75 seconds, inside 300, so a crash loop reaches failed and pages.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# READY=1 once the first poll is issued, then WATCHDOG=1 every third of WatchdogSec (SPEC-026 R13).
Type=notify
ExecStart=/usr/local/lib/deck-streak/current/bin/deckstreakd bot
User=deck-streak
Group=deck-streak
StateDirectory=deck-streak
EnvironmentFile=/etc/deck-streak/deck-streak.env
# Each credential is read from the private rail's socket at every start and never stored (ADR-038):
# the bot token and the owner for the transport and the gate (SPEC-026 R1). The bot holds no sync
# login: the owner's /sync asks the sync job, which needs more memory than this unit's limit, by
# touching the request file its path unit watches (SPEC-059, ADR-066).
LoadCredential=owner-user-id:/run/deck-streak-credentials/socket
LoadCredential=telegram-bot-token:/run/deck-streak-credentials/socket
# The one directory the bot may write beside its state: the request file, which the tmpfiles line
# deploy/tmpfiles.d/deck-streak-sync-request.conf creates for the service user alone.
ReadWritePaths=/run/deck-streak-sync
Restart=on-failure
RestartSec=15
WatchdogSec=90
TimeoutStartSec=180
TimeoutStopSec=30
OOMPolicy=kill
SyslogIdentifier=deck-streak-bot
# The budget is deploy/host-budget.json's entry for this unit (ADR-032); the processor share is
# ADR-347 D7's.
MemoryHigh=64M
MemoryMax=96M
CPUQuota=20%
TasksMax=64
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX carries the sd_notify datagram, and AF_INET and AF_INET6 the outbound requests.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
