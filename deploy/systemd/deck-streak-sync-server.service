# DeckStreak's sync server: the engine's own server, built at the tag from the engine's pin and
# shipped in the release as bin/anki-sync-server (SPEC-337 R1, R2; ADR-347 D1 to D3). Its launcher
# reads the two sync users from the credential socket, refuses an entry that is not a user name and
# a pbkdf2-sha256 hash, and execs the server on the loopback address the settings file names, with
# its data in this unit's own state directory. The Caddy block proxies /anki-sync/ to that address.
# A template with neutral values that the private rail fills (deploy/README.md).
[Unit]
Description=DeckStreak sync server for the owner's Anki clients
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/deploy/README.md
# A server that keeps failing pages once through the alert path and then stays down.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=deck-streak-alert@%n.service
# The server never calls sd_notify, so no watchdog can watch it; a stopped server pages through
# OnFailure=.
X-DurableServices-Waive=watchdog-missing the sync server sends no sd_notify keep-alives, so a watchdog would kill a healthy process, and OnFailure= judges it instead

[Service]
# exec: the unit is active once the launcher has exec'd the server, which sends no readiness.
Type=exec
ExecStart=/usr/local/lib/deck-streak/current/deploy/scripts/sync-server.sh
# The sync family's own user and group, which no other unit runs as (SPEC-340 R2; ADR-351 D1).
User=deck-streak-sync
Group=deck-streak-sync
# The users' collections and media, one directory per user; the launcher points the server here.
StateDirectory=deck-streak-sync-server
# The launcher reads the loopback address it listens on from this file.
EnvironmentFile=/etc/deck-streak/deck-streak.env
# The owner's user and the staging user, each `name:<pbkdf2-sha256 hash>` (ADR-347 D2, ADR-344).
LoadCredential=sync-server-owner:/run/deck-streak-credentials/socket
LoadCredential=sync-server-staging:/run/deck-streak-credentials/socket
Restart=on-failure
# The server finishes its open requests and stops on an interrupt, and on no other signal.
KillSignal=SIGINT
TimeoutStopSec=30
RestartSec=15
OOMPolicy=kill
SyslogIdentifier=deck-streak-sync-server
# The budget is deploy/host-budget.json's entry for this unit (ADR-032, ADR-347): a full upload of
# the reference collection peaks under MemoryHigh=, and the processor share is ADR-347 D7's.
MemoryHigh=384M
MemoryMax=448M
CPUQuota=75%
TasksMax=64
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# It listens on a loopback IPv4 address, and reaches nothing else.
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
# Enabling the server enables the snapshot's stopped-server window and its archive in the daily
# backup's run, and its drill in the restore drill's run; disabling it removes all three (ADR-347
# D12; ADR-351 D1).
Also=deck-streak-sync-snapshot.service
Also=deck-streak-sync-archive.service
Also=deck-streak-sync-restore-drill.service
