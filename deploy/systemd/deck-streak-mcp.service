# DeckStreak's MCP server: the adapter the owner's agent calls on a loopback address, behind the
# bearer guard (SPEC-119; ADR-119, ADR-329, ADR-332). A template with neutral values that the
# private rail fills (deploy/README.md); nothing in it is one host's value. The deploy installs it
# and never starts it: its first start is the owner's, once the core token is in the private rail.
[Unit]
Description=DeckStreak MCP server, the adapter the owner's agent calls on a loopback address
Documentation=https://github.com/RexRenatus/deck-streak/blob/main/deploy/README.md
# A failed unit pages through the one alert path (the alert template is SPEC-031's).
OnFailure=deck-streak-alert@%n.service
# Five starts at RestartSec=15 take 75 seconds, inside 300, so a crash loop reaches failed and pages.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# READY=1 once the loopback listener is bound, then WATCHDOG=1 every third of WatchdogSec (SPEC-119).
Type=notify
ExecStart=/usr/local/lib/deck-streak/current/bin/deckstreakd mcp
User=deck-streak
Group=deck-streak
StateDirectory=deck-streak
EnvironmentFile=/etc/deck-streak/deck-streak.env
# Each token is read from the private rail's socket at every start and never stored (ADR-038), and
# the role refuses start on a core token it cannot read, naming its id (SPEC-119 R6).
LoadCredential=mcp-core-token:/run/deck-streak-credentials/socket
LoadCredential=mcp-law-track-token:/run/deck-streak-credentials/socket
Restart=on-failure
RestartSec=15
WatchdogSec=90
TimeoutStartSec=180
TimeoutStopSec=30
OOMPolicy=kill
SyslogIdentifier=deck-streak-mcp
# The budget is deploy/host-budget.json's entry for this unit (ADR-032), and its CPU quota is taken
# from the API's (ADR-332), then split again by ADR-347 D7. Both are ceilings the kernel enforces:
# past MemoryMax the unit is killed, fails and pages, and past CPUQuota it is throttled.
MemoryHigh=24M
MemoryMax=32M
CPUQuota=15%
TasksMax=32
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX carries the sd_notify datagram, and AF_INET and AF_INET6 the loopback listener.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Its only peers are on loopback: the owner's agent, which calls its listener. Every other address
# is denied, the host's identity endpoint among them (SPEC-395 R1; ADR-409 D2; SPEC-354 R1;
# ADR-365 D1).
IPAddressAllow=localhost
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
