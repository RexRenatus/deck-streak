# DeckStreak's non-secret settings for its units, by name (SPEC-032 R3). Every service names the
# same required file, /etc/deck-streak/deck-streak.env, which the private rail writes; this example
# holds neutral values only. A secret is never a variable here: each reaches its unit as a systemd
# credential from the private rail's socket (ADR-038). systemd itself sets STATE_DIRECTORY and
# CREDENTIALS_DIRECTORY, so neither belongs here.

# The hour the study day turns over, 0 to 23. The timers' calendars are written at this hour, in UTC
# to match the offset below; the private rail renders the timers and these two settings together.
DECKSTREAK_ROLLOVER_HOUR=4

# The fixed offset from UTC the rollover hour is local to, in whole minutes, -720 to 840. The
# deployment's own offset is private configuration.
DECKSTREAK_UTC_OFFSET_MINUTES=0

# The hour the daily digest goes out, 0 to 23, never before the rollover hour. Unset, it is the
# larger of 9 and the rollover hour.
DECKSTREAK_DIGEST_HOUR=

# How many blocking operations run at once, 1 to 512. Default 1.
DECKSTREAK_OFFLOAD_WORKERS=1

# The log level, in tracing's filter directives.
RUST_LOG=info

# The address the API listens on (the api role): a loopback address with a port. The Caddy block
# proxies /api/* to this same address, its DECKSTREAK_API_UPSTREAM (deploy/README.md). Required.
DECKSTREAK_API_LISTEN=127.0.0.1:8080

# How old Telegram's launch data may be when the Mini App opens a session, in whole seconds, 1 to
# 86400. Default 3600.
DECKSTREAK_INIT_DATA_MAX_AGE_SECONDS=3600

# The Anki sync server's URL (the sync job, which also serves the owner's /sync). The deployment's
# own URL is private configuration, so no example is given. Required by the sync.
DECKSTREAK_SYNC_ENDPOINT=

# The file the bot touches to ask for the owner's /sync and the sync path unit watches (SPEC-059).
# An absolute path; unset it and the default stands.
# DECKSTREAK_SYNC_REQUEST_PATH=/run/deck-streak-sync/request

# The Mini App's https: URL, which the bot's /start button opens (the bot role; SPEC-026). The
# deployment's own host name is private configuration, so no example is given. Required by the bot.
DECKSTREAK_MINI_APP_URL=

# The owner's courses: an absolute path to a private JSON file of the schema deckstreak.courses.v1
# (ADR-087, SPEC-071 R1); deploy/config/courses.example.json shows its shape with neutral values.
# The deployment's own file is private configuration, so no example is given. Unset, no card has a
# course.
DECKSTREAK_COURSES_FILE=

# The lapses at which a card that is not suspended counts as a leech (SPEC-071 R8), 1 to 1000.
# Default 8.
DECKSTREAK_LEECH_THRESHOLD=8

# The bucket the Litestream replica ships to (SPEC-064 R2): the name after `gs://` in
# deploy/litestream.yml, with a prefix after a slash if the owner keeps the replica in a bucket of its
# own already. The deployment's own bucket is private configuration; this value is neutral.
DECKSTREAK_REPLICA_BUCKET=deck-streak-example-replica
